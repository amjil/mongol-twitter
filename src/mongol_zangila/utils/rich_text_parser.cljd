(ns mongol-zangila.utils.rich-text-parser
  "Parses raw text and backend entity coordinates into actionable rich text spans.
   ⚡ Ultimate Pure-Scanner MVP: Completely replaces fragile RegExp with a deterministic 
   character-by-character scanner to perfectly absorb traditional Mongolian suffixes and trailing letters."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/gestures.dart" :as gestures]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [clojure.string :as str]))

;; =============================================================================
;; 1. Memory Management Helpers
;; =============================================================================

(defn- create-registry []
  (atom []))

(defn- dispose-registry [!regs]
  (doseq [^gestures/TapGestureRecognizer r @!regs]
    (.dispose r)))

;; =============================================================================
;; 2. Logic: Deterministic Character Scanner (No RegExp)
;; =============================================================================

;; ⚡ Explicit delimiter blacklist
;; Note: \u202F (NNBS) and \u180E (MVS) are excluded so Mongolian suffixes never split
(defn- stop-char? [s]
  (contains? #{" " "\n" "\t" "\r" "\u3000" "\u00A0"
               "." "," "!" "?" ";" ":" "(" ")" "[" "]" "{" "}" "<" ">" "\"" "'" "-"
               "。" "，" "！" "？" "、" "：" "；" "（" "）" "【" "】" "《" "》" "‘" "’" "“" "”"}
             s))

;; ⚡ Character-level forward scan: immune to regex-escape bugs
(defn- find-word-end [content start-idx]
  (let [c-len (count content)]
    (loop [i start-idx]
      (if (or (>= i c-len) (stop-char? (subs content i (inc i))))
        i
        (recur (inc i))))))

;; ⚡ Hashtag extractor: pure character scan
(defn- extract-dynamic-topics [text]
  (let [c-len (count text)]
    (loop [i 0
           acc []
           last-idx 0]
      (if (>= i c-len)
        (if (< last-idx c-len)
          (conj acc {"type" "text" "text" (subs text last-idx c-len)})
          acc)
        (if (= (subs text i (inc i)) "#")
          ;; Found #; start a forward scan
          (let [end (find-word-end text i)]
            (if (> end (inc i)) ;; Skip a lone #
              (let [topic-text (subs text i end)
                    new-acc (if (> i last-idx)
                              (conj acc {"type" "text" "text" (subs text last-idx i)})
                              acc)]
                (recur end (conj new-acc {"type" "topic" 
                                          "text" topic-text 
                                          "name" (str/replace-first topic-text #"^#" "")}) 
                       end))
              (recur (inc i) acc last-idx)))
          (recur (inc i) acc last-idx))))))

;; Main parse engine
(defn- parse-to-tokens [content entities]
  (let [c-len (count content)
        valid-entities (->> entities
                            (filter (fn [e]
                                      (let [s (get e "start")
                                            en (get e "end")]
                                        (and (number? s) (number? en) (>= s 0) (<= s en) (<= en c-len)))))
                            (sort-by #(get % "start")))]
    (loop [ents valid-entities
           current-idx 0
           acc []]
      (if (empty? ents)
        ;; No more backend entities; let the scanner pick up remaining #hashtags
        (if (< current-idx c-len)
          (into acc (extract-dynamic-topics (subs content current-idx c-len)))
          acc)
        (let [ent (first ents)
              start (max current-idx (get ent "start"))
              t-type (get ent "type")
              
              ;; ⚡ If the backend entity is an @mention or #hashtag, run a heal-scan to complete truncated suffixes
              safe-end (if (or (= t-type "mention") (= t-type "topic"))
                         (find-word-end content start)
                         (min c-len (max start (get ent "end"))))]
          
          (if (> start current-idx)
            ;; Emit the plain-text gap before the entity
            (let [plain-text (subs content current-idx start)]
              (recur ents start (into acc (extract-dynamic-topics plain-text))))
            
            ;; Emit the healed entity
            (let [raw-text (subs content start safe-end)
                  clean-name (cond 
                               (= t-type "mention") (str/replace-first raw-text #"^@" "")
                               (= t-type "topic") (str/replace-first raw-text #"^#" "")
                               :else (get ent "name" raw-text))
                  remaining-ents (drop-while #(< (get % "start") safe-end) (rest ents))]
              
              (recur remaining-ents safe-end (conj acc {"type" t-type
                                                        "text" raw-text
                                                        "entity_id" (get ent "entity_id")
                                                        "name" clean-name})))))))))

;; =============================================================================
;; 3. Widget: Rich Text View
;; =============================================================================

(defn rich-text-view
  "Renders an interactive rich MongolText widget with full memory safety and theme awareness.
   
   Parameters:
   - content: Raw text string.
   - entities: Vector of entities containing coordinate indices.
   - :base-size - Font size for rendering (Default: 15.0).
   - :is-me? - Set to true if rendered inside an outgoing message bubble to invert colors.
   - :max-lines / :overflow - forwarded to MongolText.rich (timeline cards pass 3 + ellipsis)."
  [ctx content entities & {:keys [base-size is-me? max-lines overflow]
                           :or {base-size 15.0 is-me? false}}]
  (f/widget
   :key (m/ValueKey (hash [content entities base-size is-me? max-lines overflow]))
   
   :managed [!recognizers (create-registry)
             :dispose dispose-registry
             
             spans (let [tokens (parse-to-tokens content entities)
                         base-color (if is-me? m/Colors.white (theme/text ctx))
                         highlight-color (if is-me? m/Colors.white theme/brand-blue)
                         decoration (if is-me? m/TextDecoration.underline m/TextDecoration.none)]
                     (mapv (fn [tok]
                             (let [t-type (get tok "type")
                                   text-val (get tok "text")]
                               (if (= t-type "text")
                                 (m/TextSpan .text text-val
                                             .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize base-size .color base-color))
                                 
                                 (let [recognizer (gestures/TapGestureRecognizer.)]
                                   (swap! !recognizers conj recognizer)
                                   (set! (.-onTap recognizer)
                                         (fn []
                                           (if (= t-type "mention")
                                             (nav/push! ctx "/profile/view" {:user-id (get tok "entity_id")})
                                             (nav/push! ctx "/search/topic" {:topic-name (get tok "name")}))
                                           nil))
                                   (m/TextSpan .text text-val
                                               .recognizer recognizer
                                               .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                                   .fontSize base-size 
                                                                   .fontWeight m/FontWeight.bold 
                                                                   .decoration decoration
                                                                   .decorationColor m/Colors.white
                                                                   .color highlight-color))))))
                           tokens))
             :dispose nil]
   
   (let [span (m/TextSpan .children spans)]
     (if max-lines
       (mgl/MongolText.rich span
                            .maxLines max-lines
                            .overflow (or overflow m/TextOverflow.ellipsis))
       (mgl/MongolText.rich span)))))