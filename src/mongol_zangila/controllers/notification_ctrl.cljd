(ns mongol-zangila.controllers.notification-ctrl
  "Domain controller for handling user notifications.
   Orchestrates local state clearing, global badge sync, and background read markers."
  (:require
   ["dart:core" :as dc]
   [mongol-zangila.state :as state]
   [mongol-zangila.infrastructure.api :as api]
   [components.toast :as toast]))

(defn load-notifications!
  "Fetches cursor-paginated notifications.
   !cursor holds the opaque next_cursor (nil on the first page).
   Completes with true on success and false on failure so callers can
   skip mark-all-read! and show an error state."
  [ctx !notifications !cursor !has-more? !loading-state? is-refresh?]
  (when is-refresh?
    (reset! !has-more? true))

  (reset! !loading-state? true)

  (let [request-cursor (when-not is-refresh? @!cursor)]
    (-> (api/get-req (api/cursor-url "/notifications" 20 request-cursor))
        (.then (fn [res]
                 (let [new-notes (try (vec (get res "data" []))
                                      (catch dc/dynamic _ []))
                       [more? next-cursor] (api/read-list-meta res)]
                   (if is-refresh?
                     (reset! !notifications new-notes)
                     (swap! !notifications #(vec (concat % new-notes))))

                   (reset! !cursor next-cursor)
                   (reset! !has-more? more?)
                   (reset! !loading-state? false)
                   true)))
        (.catchError (fn [err]
                       (reset! !loading-state? false)
                       (toast/error ctx (str "Мэдэгдэл татахад алдаа гарлаа: " err) :fade)
                       false)))))

(defn mark-all-read!
  "⚡ Optimistically flushes the global unread count to 0 instantly,
   then syncs all unread notifications to the backend in one request."
  []
  (reset! state/unread-notifications-count 0)
  (-> (api/post-req "/notifications/read-all" {})
      (.catchError (fn [_] nil))))