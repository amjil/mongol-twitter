(ns mongol-zangila.controllers.search-ctrl
  "Domain controller for search capabilities.
   Manages user/topic lookups and trending topic hydration."
  (:require
   ["dart:core" :as dc]
   [clojure.string :as str]
   [mongol-zangila.infrastructure.api :as api]
   [components.toast :as toast]))

;; =============================================================================
;; 0. Interceptors & Sanitizers
;; =============================================================================

(defn- extract-data
  "Safely extracts list data from Dart JSON responses.
   Bypasses Clojure's type checks (map?, sequential?) which fail on native Dart objects."
  [res]
  (try
    (let [d (get res "data")]
      (vec (if (some? d) d res)))
    (catch dc/dynamic _ [])))

(defn- clean-query
  "Strips leading @ or # so the backend can match raw handles/topics."
  [q]
  (-> q str/trim (str/replace-first #"^[@#]" "")))

(defn- dispatch-search!
  [ctx query-text path !results !loading? err-prefix]
  (let [query (clean-query query-text)]
    (if (str/blank? query)
      (do
        (reset! !results [])
        (reset! !loading? false))
      (do
        (reset! !loading? true)
        (let [encoded-query (dc/Uri.encodeComponent query)]
          (-> (api/get-req (str path encoded-query "&limit=20"))
              (.then (fn [res]
                       (reset! !results (extract-data res))
                       (reset! !loading? false)))
              (.catchError (fn [err]
                             (reset! !loading? false)
                             (toast/error ctx (str err-prefix err))))))))))

;; =============================================================================
;; 1. Discovery & Trends
;; =============================================================================

(defn load-trending-topics!
  "Fetches popular hashtags to populate the default search view.
   !error? is set true on failure so the UI can offer a retry."
  [ctx !trends !loading? !error?]
  (reset! !loading? true)
  (reset! !error? false)
  (-> (api/get-req "/topics/trending")
      (.then (fn [res]
               (reset! !trends (extract-data res))
               (reset! !error? false)
               (reset! !loading? false)))
      (.catchError (fn [err]
                     (reset! !loading? false)
                     (reset! !error? true)
                     (toast/error ctx (str "Алдаа гарлаа: " err))))))

;; =============================================================================
;; 2. Query Dispatching
;; =============================================================================

(defn search-posts!
  "Full-text search against posts."
  [ctx query-text !results !loading?]
  (dispatch-search! ctx query-text "/search?q=" !results !loading?
                    "Хайлт хийхэд алдаа гарлаа: "))

(defn search-users!
  "Looks up user accounts or handles matching the given query text."
  [ctx query-text !users !loading?]
  (dispatch-search! ctx query-text "/search/users?q=" !users !loading?
                    "Хэрэглэгч хайхад алдаа гарлаа: "))

(defn search-topics!
  "Looks up hashtags matching the given query text."
  [ctx query-text !topics !loading?]
  (dispatch-search! ctx query-text "/search/topics?q=" !topics !loading?
                    "Сэдэв хайхад алдаа гарлаа: "))
