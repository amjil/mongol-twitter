(ns mongol-zangila.ui.search.explore
  "The Discovery / Explore viewport.
   Root search tab: a dummy search pill routes to active search;
   the rest of the page is a horizontal gallery of trending topics."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   [cljd.flutter :as f]
   [clojure.string :as str]
   [mongol-zangila.controllers.search-ctrl :as search-ctrl]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.layout.scaffold :as scaffold]
   [mongol-zangila.ui.widgets.empty-state :as empty-state]
   [mongol-zangila.ui.search.components.search-input :as search-input]))

;; =============================================================================
;; 1. Sub-components
;; =============================================================================

(defn- dummy-search-bar
  "Read-only pill that matches search-field styling and opens active search."
  [ctx]
  (m/GestureDetector
   .onTap #(nav/push! ctx "/search/active")
   .behavior m/HitTestBehavior.opaque
   .child
   (m/Container
    .width search-input/rail-width
    .padding (m/EdgeInsets.symmetric .vertical 16.0 .horizontal 12.0)
    .decoration (m/BoxDecoration
                 .color (theme/surface-2 ctx)
                 .borderRadius (m/BorderRadius.circular theme/radius-pill)
                 .border (m/Border.all .color (theme/border ctx) .width 1.0))
    .child
    (m/Column
     .crossAxisAlignment m/CrossAxisAlignment.center
     .children
     [(m/Padding
       .padding (m/EdgeInsets.only .top 12.0)
       .child (m/Icon m/Icons.search_rounded .color (theme/text-2 ctx) .size 20.0))
      (m/SizedBox .height 12.0)
      (mgl/MongolText "Хайх..."
                      .style (m/TextStyle .fontFamily "OyunQaganTig"
                                          .fontSize 15.0
                                          .color (theme/text-2 ctx)))]))))

(defn- trending-tile
  "Vertical pillar for a trending hashtag."
  [ctx topic-data]
  (let [topic-name (str/replace-first (get topic-data "name" "") #"^#" "")
        post-count (get topic-data "post_count" 0)]
    (m/InkWell
     .onTap #(when-not (str/blank? topic-name)
               (nav/push! ctx "/search/topic" {:topic-name topic-name}))
     .child
     (m/Container
      .width 110.0
      .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 8.0)
      .decoration (m/BoxDecoration
                   .color (theme/surface ctx)
                   .border (m/Border .right (m/BorderSide .color (theme/border ctx) .width 0.5)))
      .child
      (m/Column
       .children
       [(m/Container
         .padding (m/EdgeInsets.all 12.0)
         .decoration (m/BoxDecoration .color (theme/bg ctx) .shape m/BoxShape.circle)
         .child (m/Icon m/Icons.tag_rounded .color theme/brand-blue .size 20.0))

        (m/SizedBox .height 24.0)

        (m/Expanded
         .child
         (m/Row
          .mainAxisAlignment m/MainAxisAlignment.center
          .crossAxisAlignment m/CrossAxisAlignment.start
          .children
          [(mgl/MongolText (str "#" topic-name)
                           .style (m/TextStyle .fontFamily "OyunQaganTig"
                                               .fontSize 16.0
                                               .fontWeight m/FontWeight.bold
                                               .color (theme/text ctx))
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)
           (m/SizedBox .width 8.0)
           (mgl/MongolText (str post-count " нийтлэл")
                           .style (m/TextStyle .fontFamily "OyunQaganTig"
                                               .fontSize 13.0
                                               .color (theme/text-2 ctx))
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)]))])))))

(defn- status-sliver
  "A bounded-width column so empty-state/spinner can live in a horizontal sliver."
  [child]
  (m/SliverToBoxAdapter
   .child
   (m/SizedBox
    .width 220.0
    .child child)))

;; =============================================================================
;; 2. Main Explore Screen
;; =============================================================================

(defn explore-screen
  "The primary discovery feed without keyboard interference."
  []
  (let [!trends (atom [])
        !loading-trends? (atom true)
        !trends-error? (atom false)]

    (f/widget
     :context ctx
     :watch [trends !trends
             loading? !loading-trends?
             error? !trends-error?]

     (let [reload! #(search-ctrl/load-trending-topics! ctx !trends !loading-trends? !trends-error?)]
       (pft/PostFrameTrigger
        .onLayout reload!
        .child
        (scaffold/app-scaffold
         ctx "/search"
         ;; SafeArea.bottom false: the tab bar already consumes the home indicator.
         (m/SafeArea
          .bottom false
          .child
          (m/CustomScrollView
           .scrollDirection m/Axis.horizontal
           .physics (m/BouncingScrollPhysics.)
           .slivers
           (vec
            (keep identity
                  [(m/SliverToBoxAdapter
                    .child
                    (m/Padding
                     .padding (m/EdgeInsets.only .left 16.0 .right 8.0 .top 16.0 .bottom 16.0)
                     .child (dummy-search-bar ctx)))

                   (when loading?
                     (status-sliver
                      (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))))

                   (when (and (not loading?) error?)
                     (status-sliver
                      (empty-state/empty-view ctx
                                              :icon-data m/Icons.wifi_off_rounded
                                              :title "Тренд ачааллаж чадсангүй"
                                              :subtitle "Сүлжээгээ шалгаад дахин оролдоно уу."
                                              :action-label "Дахин оролдох"
                                              :on-action reload!)))

                   (when (and (not loading?) (not error?) (empty? trends))
                     (status-sliver
                      (empty-state/empty-view ctx
                                              :icon-data m/Icons.tag_rounded
                                              :title "Тренд сэдэв алга"
                                              :subtitle "Одоогоор популяр сэдэв байхгүй байна.")))

                   (when (and (not loading?) (seq trends))
                     (m/SliverToBoxAdapter
                      .child
                      (m/Container
                       .width 56.0
                       .padding (m/EdgeInsets.only .top 24.0)
                       .alignment m/Alignment.topCenter
                       .child (mgl/MongolText "Тренд сэдвүүд"
                                              .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                                  .fontSize 14.0
                                                                  .fontWeight m/FontWeight.bold
                                                                  .color (theme/text-2 ctx))))))

                   (when (and (not loading?) (seq trends))
                     (m/SliverList
                      .delegate
                      (m/SliverChildBuilderDelegate
                       (f/build [i]
                                (trending-tile ctx (nth trends i)))
                       .childCount (count trends))))]))))))))))
