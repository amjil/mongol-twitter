(ns mongol-zangila.ui.chat.group
  "Group conversation. Thin wrapper around the shared thread shell."
  (:require
   [mongol-zangila.state :as state]
   [mongol-zangila.controllers.chat-ctrl :as chat-ctrl]
   [mongol-zangila.ui.chat.thread :as thread]))

(defn group-chat-screen
  [group-id group-name member-count]
  (let [current-user @state/current-user]
    (thread/thread-screen
     {:title (or group-name "")
      :subtitle (when member-count (str member-count " гишүүнтэй"))
      :info-route "/chat/group-info"
      :info-args {:group-id group-id}
      :topic (chat-ctrl/group-topic group-id)
      :initialize! (fn [ctx !messages !loading? current-user-id !chat-topic]
                     (chat-ctrl/initialize-group-thread! ctx group-id !messages !loading? current-user-id !chat-topic))
      :retry-id group-id
      :show-sender-info? true
      :on-send-text (fn [ctx !messages content entities]
                      (chat-ctrl/dispatch-group-message! ctx group-id content entities !messages current-user))
      :make-send-image (fn [ctx !messages]
                         (chat-ctrl/send-image-message! ctx group-id
                                                        (str "/chat/groups/" group-id "/messages")
                                                        !messages
                                                        :extra-fields {"sender" current-user}))
      :make-send-voice (fn [ctx !messages]
                         (chat-ctrl/send-voice-message! ctx group-id
                                                        (str "/chat/groups/" group-id "/messages")
                                                        !messages
                                                        :extra-fields {"sender" current-user}))})))
