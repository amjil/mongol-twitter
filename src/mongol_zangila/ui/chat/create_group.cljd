(ns mongol-zangila.ui.chat.create-group
  "Viewport for creating a new group chat.
   Features a horizontal gallery layout optimized for vertical Mongolian typography:
   Left pillar for group metadata, right gallery for member multi-selection.
   ⚡ Updated: Fetches the active user's following list as the contact source."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   [cljd.flutter :as f]
   [clojure.string :as str]

   [mongol-zangila.infrastructure.api :as api]
   [mongol-zangila.state :as state] ;; ⚡ 引入全局状态以获取当前登录用户 ID
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [components.toast :as toast]
   
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]))

;; =============================================================================
;; 1. Core Data & Mutation Operations
;; =============================================================================

(defn- load-friends-for-selection! 
  "⚡ Fetches users that the current logged-in user is following.
   Aligns with the 'GET /users/:user_id/following' API specification."
  [ctx !friends !loading?]
  (let [current-user-id (get @state/current-user "id")]
    (if-not current-user-id
      (do
        (reset! !loading? false)
        (toast/error ctx "Хэрэглэгчийн мэдээлэл олдсонгүй.")) ;; User session not found
      (do
        (reset! !loading? true)
        (-> (api/get-req (str "/users/" current-user-id "/following"))
            (.then (fn [res]
                     (reset! !friends (get res "data" []))
                     (reset! !loading? false)))
            (.catchError (fn [err]
                           (reset! !loading? false)
                           (toast/error ctx (str "Дагаж буй хэрэглэгчдийн жагсаалт татахад алдаа гарлаа: " err)))))))))

(defn- create-group-submit!
  "Submits the group creation payload to the backend and navigates to the new group."
  [ctx group-name selected-user-ids !creating?]
  (cond
    (str/blank? group-name)
    (toast/warn ctx "Группийн нэрийг оруулна уу.") ;; "Please enter a group name"
    
    (empty? selected-user-ids)
    (toast/warn ctx "Хамгийн багадаа 1 гишүүн сонгоно уу.") ;; "Please select at least 1 member"
    
    :else
    (do
      (reset! !creating? true)
      (-> (api/post-req "/chat/groups" 
                        {"name" group-name 
                         "member_ids" (vec selected-user-ids)})
          (.then (fn [res]
                   (reset! !creating? false)
                   (toast/success ctx "Групп амжилттай үүслээ.")
                   (let [group-id (get-in res ["data" "id"])]
                     ;; ⚡ Replace the current screen with the newly created Group Chat viewport
                     (nav/push-replacement! ctx "/chat/group" 
                                            {:group-id group-id 
                                             :group-name group-name 
                                             :member-count (inc (count selected-user-ids))}))))
          (.catchError (fn [err]
                         (reset! !creating? false)
                         (toast/error ctx (str "Групп үүсгэхэд алдаа гарлаа: " err))))))))

;; =============================================================================
;; 2. UI Sub-components
;; =============================================================================

(defn- user-selection-card
  "A vertical pillar representing a selectable user."
  [ctx user is-selected? on-toggle]
  (let [user-id (get user "id")
        name (get user "name" "Unknown")
        handle (get user "handle" "user")
        avatar-url (get user "avatar_url" "")]
    (m/GestureDetector
     .onTap on-toggle
     .child
     (m/Container
      .width 120.0
      .margin (m/EdgeInsets.only .right 12.0 .top 16.0 .bottom 16.0)
      .decoration (m/BoxDecoration 
                   .color (if is-selected? (.withOpacity theme/brand-blue 0.05) m/Colors.white)
                   .borderRadius (m/BorderRadius.circular 16.0)
                   .border (m/Border.all 
                            .color (if is-selected? theme/brand-blue theme/border-color) 
                            .width (if is-selected? 2.0 1.0)))
      .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 8.0)
      .child
      (m/Column
       .mainAxisAlignment m/MainAxisAlignment.start
       .crossAxisAlignment m/CrossAxisAlignment.center
       .children
       [
        ;; Custom Checkbox Indicator
        (m/Container
         .width 28.0 .height 28.0
         .decoration (m/BoxDecoration 
                      .shape m/BoxShape.circle
                      .color (if is-selected? theme/brand-blue m/Colors.transparent)
                      .border (m/Border.all .color (if is-selected? theme/brand-blue theme/border-color) .width 2.0))
         .child (if is-selected? (m/Icon m/Icons.check_rounded .color m/Colors.white .size 18.0) (m/SizedBox.shrink)))
        
        (m/SizedBox .height 24.0)
        (smart-avatar/smart-avatar ctx user-id avatar-url :size 56.0)
        (m/SizedBox .height 24.0)
        
        (m/Expanded
         .child
         (m/Row
          .mainAxisAlignment m/MainAxisAlignment.center
          .crossAxisAlignment m/CrossAxisAlignment.start
          .children
          [(mgl/MongolText name 
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 16.0 .color theme/text-primary)
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)
           (m/SizedBox .width 6.0)
           (mgl/MongolText (str "@" handle)
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color theme/text-secondary)
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)]))])))))

;; =============================================================================
;; 3. The Main Screen Widget
;; =============================================================================

(defn create-group-screen []
  (let [!friends (atom [])
        !loading? (atom true)
        !creating? (atom false)
        !selected-user-ids (atom #{})] ;; ⚡ Uses a Set for O(1) toggling and exact-once uniqueness
    
    (f/widget
     :context ctx
     
     ;; ⚡ 利用 :managed 完美托管 TextEditingController 的生命周期
     :managed [group-name-ctrl (m/TextEditingController. .text "")
               :dispose .dispose]
               
     :watch [friends !friends
             loading? !loading?
             creating? !creating?
             selected-ids !selected-user-ids]
     
     (pft/PostFrameTrigger
      .onLayout #(load-friends-for-selection! ctx !friends !loading?)
      .child
      (m/Scaffold
       .backgroundColor theme/bg-color
       
       ;; --- Top App Bar ---
       .appBar
       (m/AppBar
        .backgroundColor m/Colors.white
        .elevation 0.5
        .leading (m/IconButton 
                  .icon (m/Icon m/Icons.arrow_back_rounded .color theme/text-primary)
                  .onPressed #(nav/pop! ctx))
        .title (m/Text "Шинэ групп" ;; "New Group"
                       .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0 .fontWeight m/FontWeight.bold .color theme/text-primary))
        .actions [(m/Padding
                   .padding (m/EdgeInsets.only .right 16.0 .top 8.0 .bottom 8.0)
                   .child
                   (m/ElevatedButton
                    .style (m/ElevatedButton.styleFrom 
                            .backgroundColor theme/brand-blue
                            .elevation 0.0
                            .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 20.0)))
                    .onPressed (if creating? 
                                 nil 
                                 #(create-group-submit! ctx (.-text group-name-ctrl) selected-ids !creating?))
                    .child (if creating?
                             (m/SizedBox .width 20.0 .height 20.0 .child (m/CircularProgressIndicator .strokeWidth 2.0 .color m/Colors.white))
                             (m/Text "Үүсгэх" .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .color m/Colors.white)))))])
       
       ;; --- Main Body: Horizontal LTR Flow ---
       .body
       (m/Row
        .crossAxisAlignment m/CrossAxisAlignment.stretch
        .children
        [
         ;; Pillar 1: Group Metadata Setup
         (m/Container
          .padding (m/EdgeInsets.all 24.0)
          .decoration (m/BoxDecoration 
                       .color m/Colors.white
                       .border (m/Border .right (m/BorderSide .color theme/border-color .width 1.0)))
          .child
          (m/Column
           .crossAxisAlignment m/CrossAxisAlignment.center
           .children
           [
            ;; Group Avatar Placeholder
            (m/Container
             .width 80.0 .height 80.0
             .decoration (m/BoxDecoration .color (.withOpacity theme/brand-blue 0.1) .shape m/BoxShape.circle)
             .child (m/Icon m/Icons.add_a_photo_rounded .color theme/brand-blue .size 32.0))
            
            (m/SizedBox .height 40.0)
            
            ;; Vertical Text Input for Group Name
            (m/Expanded
             .child
             (mgl/MongolTextField
              .controller group-name-ctrl
              .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0 .fontWeight m/FontWeight.bold .color theme/text-primary)
              .decoration (m/InputDecoration
                           .hintText "Группийн нэр..." ;; "Group Name..."
                           .hintStyle (m/TextStyle .color theme/text-secondary .fontWeight m/FontWeight.normal)
                           .border m/InputBorder.none
                           .focusedBorder m/InputBorder.none
                           .enabledBorder m/InputBorder.none)))]))
         
         ;; Pillar 2: Member Selection Gallery (Now powered by Following List)
         (m/Expanded
          .child
          (cond
            ;; 状态1：正在加载网络请求
            loading?
            (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))
            
            ;; ⚡ 状态2：关注列表为空（展现友好的引导 UI）
            (empty? friends)
            (m/Center
             .child
             (m/Column
              .mainAxisAlignment m/MainAxisAlignment.center
              .crossAxisAlignment m/CrossAxisAlignment.center
              .children
              [(m/Container
                .padding (m/EdgeInsets.all 24.0)
                .decoration (m/BoxDecoration .color (.withOpacity theme/brand-blue 0.05) .shape m/BoxShape.circle)
                .child (m/Icon m/Icons.group_off_rounded .size 48.0 .color theme/brand-blue))
               
               (m/SizedBox .height 24.0)
               
               (mgl/MongolText "Дагасан хэрэглэгч байхгүй байна." ;; "There are no followed users."
                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color theme/text-secondary))
               
               (m/SizedBox .height 32.0)
               
               ;; 引导去探索界面的按钮
               (m/ElevatedButton
                .style (m/ElevatedButton.styleFrom
                        .backgroundColor m/Colors.white
                        .foregroundColor theme/brand-blue
                        .elevation 0.0
                        .shape (m/RoundedRectangleBorder 
                                .borderRadius (m/BorderRadius.circular 24.0)
                                .side (m/BorderSide .color theme/brand-blue .width 1.5))
                        .padding (m/EdgeInsets.symmetric .horizontal 32.0 .vertical 12.0))
                .onPressed (fn []
                             (nav/pop! ctx) ;; 退出当前的建群页面
                             (nav/push! ctx "/search")) ;; 跳转到全局搜索/探索页面
                .child (m/Text "Хэрэглэгч хайх" ;; "Search users"
                               .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 14.0)))]))

            ;; 状态3：正常渲染成员画廊
            :else
            (m/Column
             .crossAxisAlignment m/CrossAxisAlignment.start
             .children
             [
              ;; Gallery Header
              (m/Padding
               .padding (m/EdgeInsets.only .left 16.0 .top 16.0)
               .child
               (m/Text (str "Гишүүн сонгох (" (count selected-ids) ")") ;; "Select Members (X)"
                       .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color theme/text-secondary .fontWeight m/FontWeight.bold)))
              
              ;; Horizontal User List
              (m/Expanded
               .child
               (m/ListView.builder
                .scrollDirection m/Axis.horizontal
                .physics (m/BouncingScrollPhysics.)
                .padding (m/EdgeInsets.only .left 16.0)
                .itemCount (count friends)
                .itemBuilder
                (fn [_ i]
                  (let [user (nth friends i)
                        u-id (get user "id")
                        is-sel? (contains? selected-ids u-id)]
                    (user-selection-card 
                     ctx user is-sel? 
                     #(swap! !selected-user-ids (fn [s] (if is-sel? (disj s u-id) (conj s u-id)))))))))])))]))))))