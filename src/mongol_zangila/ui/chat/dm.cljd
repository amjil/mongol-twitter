(ns mongol-zangila.ui.chat.dm
  "Direct message conversation. Thin wrapper around the shared thread shell."
  (:require
   [mongol-zangila.controllers.chat-ctrl :as chat-ctrl]
   [mongol-zangila.ui.chat.thread :as thread]))

(defn dm-screen
  [thread-id partner-name partner-id]
  (thread/thread-screen
   {:title (or partner-name "")
    :info-route (when partner-id "/chat/dm-info")
    :info-args {:thread-id thread-id :partner-id partner-id :initial-name partner-name}
    :topic (chat-ctrl/thread-topic thread-id)
    :initialize! (fn [ctx !messages !loading? current-user-id !chat-topic]
                   (chat-ctrl/initialize-dm-thread! ctx thread-id !messages !loading? current-user-id !chat-topic))
    :retry-id thread-id
    :partner-id partner-id
    :partner-name partner-name
    :on-send-text (fn [ctx !messages content entities]
                    (chat-ctrl/dispatch-message! ctx thread-id content entities !messages))
    :make-send-image (fn [ctx !messages]
                       (chat-ctrl/send-image-message! ctx thread-id
                                                      (str "/chat/threads/" thread-id "/messages")
                                                      !messages))
    :make-send-voice (fn [ctx !messages]
                       (chat-ctrl/send-voice-message! ctx thread-id
                                                      (str "/chat/threads/" thread-id "/messages")
                                                      !messages))}))
