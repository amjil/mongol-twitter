(ns mongol-zangila.ui.chat.admin
  "Group administration viewport.
   Provides elevated access controls for modifying group metadata and members.
   Architected as a horizontal gallery of vertical pillars for LTR Mongolian typography."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   
   ;; Centralized Dart Interop Interceptor
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   
   [cljd.flutter :as f]
   [clojure.string :as str]
   
   ;; System Infrastructure
   [mongol-zangila.infrastructure.api :as api]
   [mongol-zangila.state :as state]
   
   ;; UI & Shared Components
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]
   [components.toast :as toast]))

;; =============================================================================
;; 1. Data Fetching & Core Mutations
;; =============================================================================

(defn- load-admin-context! 
  "Hydrates the admin viewport with the latest group metadata and member list."
  [ctx group-id ^m/TextEditingController name-ctrl !members !loading?]
  
  (reset! !loading? true)
  (-> (api/get-req (str "/chat/groups/" group-id "/details"))
      (.then (fn [res]
               (let [data (get res "data" {})
                     group-name (get data "name" "")
                     member-list (get data "members" [])]
                 
                 ;; Seed the text controller with the current group name
                 (set! (.-text name-ctrl) group-name)
                 (reset! !members member-list)
                 (reset! !loading? false))))
      
      (.catchError (fn [err]
                     (reset! !loading? false)
                     (toast/error ctx (str "Мэдээлэл татахад алдаа гарлаа: " err))))))

(defn- save-group-metadata! 
  "Dispatches a mutation to update the group's name and settings."
  [ctx group-id ^m/TextEditingController name-ctrl !saving?]
  
  (let [new-name (str/trim (.-text name-ctrl))]
    (if (str/blank? new-name)
      (toast/warn ctx "Группийн нэрийг хоосон орхиж болохгүй.") ;; "Group name cannot be empty."
      (do
        (reset! !saving? true)
        (-> (api/post-req (str "/chat/groups/" group-id "/update") {"name" new-name})
            (.then (fn [_]
                     (reset! !saving? false)
                     (toast/success ctx "Амжилттай хадгалагдлаа.") ;; "Successfully saved."
                     (nav/pop! ctx)))
            (.catchError (fn [err]
                           (reset! !saving? false)
                           (toast/error ctx (str "Хадгалах үед алдаа гарлаа: " err)))))))))

(defn- promote-member!
  [ctx group-id target-user-id !members]
  (let [prev-members @!members]
    (swap! !members
           (fn [members]
             (mapv #(if (= (get % "id") target-user-id)
                      (assoc % "role" "admin")
                      %)
                   members)))
    (-> (api/post-req (str "/chat/groups/" group-id "/promote") {"user_id" target-user-id})
        (.then (fn [_] (toast/success ctx "Админ эрх өгөгдлөө."))) ;; "Admin rights granted."
        (.catchError (fn [err]
                       (reset! !members prev-members)
                       (toast/error ctx (str "Алдаа гарлаа: " err)))))))

(defn- kick-member! 
  "Removes a participant from the group and optimistically updates the local member array."
  [ctx group-id target-user-id !members]
  
  (swap! !members (fn [current-list] 
                    (vec (remove #(= (get % "id") target-user-id) current-list))))
  
  (-> (api/post-req (str "/chat/groups/" group-id "/kick") {"user_id" target-user-id})
      (.then (fn [_] (toast/success ctx "Гишүүнийг хаслаа."))) ;; "Member removed."
      (.catchError (fn [err]
                     (toast/error ctx (str "Үйлдэл амжилтгүй боллоо: " err))))))

;; =============================================================================
;; 2. Sub-components (Vertical Pillars)
;; =============================================================================

(defn- section-header 
  "Vertical text header for grouping configuration pillars."
  [title]
  (m/Container
   .width 56.0
   .padding (m/EdgeInsets.only .top 24.0)
   .alignment m/Alignment.topCenter
   .child (mgl/MongolText title
                          .style (m/TextStyle .fontFamily "OyunQaganTig"
                                              .fontSize 14.0
                                              .fontWeight m/FontWeight.bold
                                              .color theme/text-secondary))))

(defn- admin-member-tile 
  "Transforms the standard horizontal ListTile into a vertical member administration pillar."
  [ctx group-id member !members current-user-id]
  
  (let [member-id (get member "id")
        member-name (get member "name" "Unknown")
        role (get member "role" "member")
        is-self? (= member-id current-user-id)]
    
    (m/Container
     .width 100.0
     .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 8.0)
     .decoration (m/BoxDecoration 
                  .color m/Colors.white
                  .border (m/Border .right (m/BorderSide .color theme/border-color .width 0.5)))
     .child
     (m/Column
      .crossAxisAlignment m/CrossAxisAlignment.center
      .children
      [
       ;; 1. Avatar (Top)
       (smart-avatar/smart-avatar ctx member-id (get member "avatar_url") :size 56.0)
       (m/SizedBox .height 16.0)
       
       ;; 2. Name & Identity (Middle)
       (m/Expanded
        .child (mgl/MongolText (if is-self? (str member-name " (Та)") member-name)
                               .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                   .fontSize 15.0 
                                                   .color theme/text-primary 
                                                   .fontWeight m/FontWeight.w600)))
       
       (m/SizedBox .height 8.0)
       
       ;; 3. Role Badge
       (m/Container
        .padding (m/EdgeInsets.symmetric .vertical 12.0 .horizontal 4.0)
        .decoration (m/BoxDecoration 
                     .color (if (= role "admin") (.withOpacity theme/brand-blue 0.1) theme/bg-color)
                     .borderRadius (m/BorderRadius.circular 8.0))
        .child (mgl/MongolText (if (= role "admin") "Админ" "Гишүүн") ;; "Admin" / "Member"
                               .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                   .fontSize 13.0 
                                                   .color (if (= role "admin") theme/brand-blue theme/text-secondary))))
       
       (m/SizedBox .height 16.0)
       
       ;; 4. Admin Actions (Bottom)
       (if is-self?
         (m/SizedBox .height 48.0) ;; Spacer to maintain alignment if no actions
         (m/PopupMenuButton
          .icon (m/Icon m/Icons.more_vert_rounded .color theme/text-secondary)
          .onSelected (fn [action]
                        (cond
                          (= action "kick") (kick-member! ctx group-id member-id !members)
                          (= action "promote") (promote-member! ctx group-id member-id !members)))
          
          ;; Standard horizontal popup menu is kept for UX safety with OS conventions
          .itemBuilder (fn [_]
                         [(m/PopupMenuItem 
                           .value "promote"
                           .child (m/Text "Админ эрх өгөх" .style (m/TextStyle .fontFamily "OyunQaganTig")))
                          (m/PopupMenuItem 
                           .value "kick"
                           .child (m/Text "Группээс гаргах" .style (m/TextStyle .color theme/error-red .fontFamily "OyunQaganTig")))])))]))))

;; =============================================================================
;; 3. The Main Admin Screen Widget
;; =============================================================================

(defn group-admin-screen 
  "The primary viewport for group configuration and moderation."
  [group-id]
  
  (let [!members (atom [])
        !loading? (atom true)
        !saving? (atom false)
        current-user-id (get @state/current-user "id")]
    
    (f/widget
     :context ctx
     
     :managed [name-ctrl (m/TextEditingController.)]
     :watch [members !members
             loading? !loading?
             saving? !saving?]
     
     (pft/PostFrameTrigger
      .onLayout #(load-admin-context! ctx group-id name-ctrl !members !loading?)
      .child
      (m/Scaffold
       .backgroundColor theme/bg-color
       
       ;; --- Top App Bar ---
       .appBar
       (m/AppBar
        .backgroundColor m/Colors.white
        .elevation 0.5
        .leading (m/IconButton 
                  .icon (m/Icon m/Icons.close_rounded .color theme/text-primary)
                  .onPressed #(nav/pop! ctx))
        .title (m/Text "Групп тохиргоо" ;; "Group Settings"
                       .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                           .fontSize 18.0 
                                           .fontWeight m/FontWeight.bold 
                                           .color theme/text-primary))
        .actions [(if saving?
                    (m/Padding
                     .padding (m/EdgeInsets.only .right 16.0 .top 16.0 .bottom 16.0)
                     .child (m/SizedBox .width 20.0 .height 20.0 
                                        .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/brand-blue)))
                    (m/TextButton
                     .onPressed #(save-group-metadata! ctx group-id name-ctrl !saving?)
                     .child (m/Text "Хадгалах" ;; "Save"
                                    .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                        .color theme/brand-blue 
                                                        .fontWeight m/FontWeight.bold))))])
       
       ;; --- Main Body: Horizontal Settings Gallery ---
       .body
       (if loading?
         (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))
         
         (m/ListView
          ;; ⚡ Horizontal layout foundation
          .scrollDirection m/Axis.horizontal
          .physics (m/BouncingScrollPhysics.)
          
          ;; Combine static pillars and dynamic member pillars into a single array
          .children
          (vec
           (concat
            [
             ;; 1. General Settings Section Header
             (section-header "Ерөнхий") ;; "General"
             
             ;; 2. Group Name Form Pillar
             (m/Container
              .width 320.0
              .padding (m/EdgeInsets.only .top 32.0 .bottom 32.0 .left 8.0 .right 24.0)
              .child
              (m/Row
               .crossAxisAlignment m/CrossAxisAlignment.start
               .children
               [;; Vertical Label
                (mgl/MongolText "Группийн нэр" ;; "Group Name"
                                .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                    .fontSize 15.0 
                                                    .color theme/text-secondary))
                (m/SizedBox .width 16.0)
                
                ;; Horizontal Input Field embedded in the vertical flow
                (m/Expanded
                 .child
                 (m/TextField
                  .controller name-ctrl
                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0)
                  .decoration (m/InputDecoration
                               .filled true
                               .fillColor m/Colors.white
                               .border (m/OutlineInputBorder
                                        .borderRadius (m/BorderRadius.circular 12.0)
                                        .borderSide m/BorderSide.none)
                               .contentPadding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 12.0))))]))
             
             (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/border-color)
             
             ;; 3. Member Management Section Header
             (section-header "Гишүүд")] ;; "Members"
            
            ;; 4. Dynamic Member Pillars
            (map #(admin-member-tile ctx group-id % !members current-user-id) members)
            
            ;; Trailing Spacer
            [(m/SizedBox .width 48.0)])))))))))