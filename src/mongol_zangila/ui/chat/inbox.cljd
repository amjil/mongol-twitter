(ns mongol-zangila.ui.chat.inbox
  "Chat inbox viewport.
   Displays active conversations as horizontal LTR pillars, integrating 
   real-time unread badges and localized timestamp formatting."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:custom_refresh_indicator/custom_refresh_indicator.dart" :as cri]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:async" :as async]
   ["dart:core" :as dc]

   ;; Centralized Dart Interop Interceptor
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]

   [cljd.flutter :as f]
   
   ;; System Controllers & State
   [mongol-zangila.state :as state] 
   [mongol-zangila.infrastructure.db :as db] ;; ⚡ Import local offline filter store
   [mongol-zangila.controllers.chat-ctrl :as chat-ctrl]

   ;; Shared UI Components
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.widgets.empty-state :as empty-state]
   [mongol-zangila.ui.layout.scaffold :as scaffold] ;; ⚡ Global layout
   
   ;; Unified tile component that handles DM/Group routing
   [mongol-zangila.ui.chat.components.inbox-tile :as inbox-tile]

   ;; Custom Horizontal Pull-to-Refresh Library
   [pull-to-refresh.refresh :as ptr]))

;; =============================================================================
;; 1. Sub-components (Action Sheets)
;; =============================================================================

(defn- show-new-chat-options! 
  "Presents a Bottom Action Sheet to choose between a new DM or creating a new Group."
  [ctx]
  (m/showModalBottomSheet
   .context ctx
   .backgroundColor (theme/surface ctx)
   .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.vertical .top (m/Radius.circular 16.0)))
   .builder
   (fn [b-ctx]
     (m/SafeArea
      .child
      (m/Column
       .mainAxisSize m/MainAxisSize.min
       .children
       [(m/ListTile
         .leading (m/Icon m/Icons.person_search_rounded .color theme/brand-blue)
         .title (mgl/MongolText "Хэрэглэгч хайх" ;; "Search user"
                                .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 16.0 .color (theme/text ctx)))
         .onTap (fn []
                  (nav/pop! b-ctx)
                  (nav/push! ctx "/search")))
        
        (m/ListTile
         .leading (m/Icon m/Icons.group_add_rounded .color theme/brand-blue)
         .title (mgl/MongolText "Шинэ групп үүсгэх" ;; "Create new group"
                                .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 16.0 .color (theme/text ctx)))
         .onTap (fn []
                  (nav/pop! b-ctx)
                  (nav/push! ctx "/chat/create-group")))])))))

;; =============================================================================
;; 2. Main Inbox Screen Widget
;; =============================================================================

(defn inbox-screen
  "The primary viewport for direct messaging conversations."
  []
  (let [!chats (atom [])
        !blocked-ids (atom #{}) ;; ⚡ Core blocklist set
        !initial-loading? (atom true)
        !refresh-loading? (atom false)
        
        !realtime-cb (atom nil)
        current-user-id (get @state/current-user "id")
        
        cleanup-realtime! (fn [_] 
                            (chat-ctrl/unbind-inbox-realtime! !realtime-cb)
                            (chat-ctrl/unregister-inbox!)
                            nil)]

    (f/widget
     :context ctx

     :managed [scroll-ctrl (m/ScrollController.)
               :dispose .dispose
               
               dummy-realtime-ctrl nil 
               :dispose cleanup-realtime!]

     :watch [chats !chats
             blocked-ids !blocked-ids
             init-loading? !initial-loading?]

     (pft/PostFrameTrigger
      .onLayout (fn [] 
                  (chat-ctrl/register-inbox! !chats)
                  (chat-ctrl/load-inbox! ctx !chats !initial-loading? true)
                  (chat-ctrl/bind-inbox-realtime! !chats current-user-id !realtime-cb)
                  
                  ;; ⚡ Load local SQLite blocklist asynchronously
                  (-> (db/get-blocked-user-ids)
                      (.then (fn [ids] (reset! !blocked-ids ids)))))
      .child
      
      (scaffold/app-scaffold
       ctx "/chat/inbox"
       (m/Scaffold
        .backgroundColor (theme/bg ctx)

        ;; --- Top App Bar ---
        .appBar
        (m/AppBar
         .backgroundColor (theme/surface ctx)
         .elevation 0.5
         .automaticallyImplyLeading false
         .title (m/Text "Зурвас"
                        .style (m/TextStyle .fontFamily "OyunQaganTig"
                                            .fontSize 18.0
                                            .fontWeight m/FontWeight.bold
                                            .color (theme/text ctx)))
         .actions [(m/IconButton
                    .icon (m/Icon m/Icons.add_comment_rounded .color theme/brand-blue)
                    .onPressed #(show-new-chat-options! ctx))]) ;; ⚡ Show Action Sheet

        ;; --- Main Body: Horizontal Pull-to-Refresh Chat List ---
        .body
        (if init-loading?
          (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))

          ;; ⚡ Live filter: drop threads that intersect the blocklist
          (let [visible-chats (vec (remove (fn [chat]
                                             (let [p-id (or (get chat "partner_id") (get-in chat ["partner" "id"]))]
                                               (and p-id (contains? blocked-ids p-id))))
                                           chats))]
            
            (if (empty? visible-chats)
              ;; ⚡ Empty-state button also opens the Action Sheet
              (empty-state/empty-chat-view ctx #(show-new-chat-options! ctx))

              (ptr/horizontal-refresh
               {:on-refresh (fn []
                              ;; ⚡ Refresh the blocklist on pull-to-refresh in case it changed
                              (-> (db/get-blocked-user-ids) (.then #(reset! !blocked-ids %)))
                              (chat-ctrl/load-inbox! ctx !chats !refresh-loading? true))

                :scroll-controller scroll-ctrl
                :background-color (theme/bg ctx)

                :not-armed-text "Татаж шинэчлэх"
                :armed-text "Суллаж шинэчлэх"
                :loading-text "Суллаж шинэчлэх"
                :not-armed-color (theme/border ctx)
                :armed-color theme/brand-blue
                :text-style (m/TextStyle .fontFamily "OyunQaganTig" .color m/Colors.white .fontSize 14.0 .fontWeight m/FontWeight.bold)
                :trigger-mode cri/IndicatorTriggerMode.anywhere

                :item-count (count visible-chats)
                :separator-builder (fn [_ _] (m/SizedBox .width 8.0))
                :box-shadow []

                :item-builder
                (fn [_ i]
                  (let [chat-data (nth visible-chats i)
                        is-first? (zero? i)
                        is-last? (= i (dec (count visible-chats)))]
                    (m/Padding
                     .padding (m/EdgeInsets.only
                               .left (if is-first? 16.0 0.0)
                               .right (if is-last? 16.0 0.0))
                     .child (inbox-tile/inbox-tile ctx chat-data))))}))))))))))