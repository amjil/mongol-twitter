(ns mongol-zangila.ui.chat.new-chat
  "Unified new-chat picker.
   Default list = recent DM partners + following (deduped).
   Tap one person to open a DM; checkbox / long-press to multi-select and create a group."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   ["dart:async" :as async]
   ["dart:core" :as dc]
   [cljd.flutter :as f]
   [clojure.string :as str]

   [mongol-zangila.infrastructure.api :as api]
   [mongol-zangila.infrastructure.db :as db]
   [mongol-zangila.state :as state]
   [mongol-zangila.controllers.chat-ctrl :as chat-ctrl]
   [mongol-zangila.controllers.search-ctrl :as search-ctrl]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]
   [mongol-zangila.ui.widgets.empty-state :as empty-state]
   [mongol-zangila.ui.search.components.search-input :as search-input]
   [components.toast :as toast]
   [virtual-keyboard.keyboard :as keyboard]
   [virtual-keyboard.options :as options]))

;; =============================================================================
;; 1. Contact merging
;; =============================================================================

(defn- normalize-user
  [u]
  {"id" (get u "id")
   "name" (get u "name" "Unknown")
   "handle" (or (get u "handle") (get u "username") "user")
   "avatar_url" (get u "avatar_url" "")})

(defn- recent-partners
  "DM partners from inbox order (most recent first). Groups are skipped."
  [inbox-items]
  (keep (fn [thread]
          (when (not= (get thread "type") "group")
            (let [p (get thread "partner" {})
                  pid (or (get p "id") (get thread "partner_id"))]
              (when pid
                {"id" pid
                 "name" (or (get p "name") (get thread "name") "Unknown")
                 "handle" (or (get p "handle") "")
                 "avatar_url" (or (get p "avatar_url") (get thread "avatar_url") "")}))))
        inbox-items))

(defn- merge-contacts
  [recent following blocked-ids self-id]
  (let [ok? (fn [u]
              (let [id (get u "id")]
                (and id
                     (not= id self-id)
                     (not (contains? blocked-ids id)))))
        recent-ok (->> recent (map normalize-user) (filter ok?))
        seen (set (map #(get % "id") recent-ok))
        following-ok (->> following
                          (map normalize-user)
                          (filter ok?)
                          (remove #(contains? seen (get % "id"))))]
    (vec (concat
          (map #(assoc % "source" "recent") recent-ok)
          (map #(assoc % "source" "following") following-ok)))))

(defn- matches-query?
  [user q]
  (let [needle (-> q str/trim (str/replace-first #"^[@#]" "") str/lower-case)]
    (if (str/blank? needle)
      true
      (or (str/includes? (str/lower-case (str (get user "name" ""))) needle)
          (str/includes? (str/lower-case (str (get user "handle" ""))) needle)))))

(defn- visible-people
  [contacts remote query blocked-ids self-id]
  (let [q (str/trim (str query))
        local (if (str/blank? q)
                contacts
                (filterv #(matches-query? % q) contacts))
        local-ids (set (map #(get % "id") local))
        extra (if (str/blank? q)
                []
                (->> remote
                     (map #(assoc (normalize-user %) "source" "search"))
                     (filter (fn [u]
                               (let [id (get u "id")]
                                 (and id
                                      (not= id self-id)
                                      (not (contains? blocked-ids id))
                                      (not (contains? local-ids id))))))
                     vec))]
    (vec (concat local extra))))

;; =============================================================================
;; 2. Loading & mutations
;; =============================================================================

(defn- load-picker-sources!
  [ctx self-id !contacts !blocked-ids !loading?]
  (if-not self-id
    (do
      (reset! !loading? false)
      (toast/error ctx "Хэрэглэгчийн мэдээлэл олдсонгүй."))
    (do
      (reset! !loading? true)
      (-> (dc/Future.wait [(api/get-req "/chat/inbox")
                           (api/get-req (str "/users/" self-id "/following"))
                           (db/get-blocked-user-ids)])
          (.then (fn [results]
                   (let [inbox-res (first results)
                         following-res (second results)
                         blocked (nth results 2)
                         threads (get inbox-res "data" [])
                         following (get following-res "data" [])]
                     (reset! !blocked-ids (or blocked #{}))
                     (reset! !contacts (merge-contacts (recent-partners threads)
                                                       following
                                                       (or blocked #{})
                                                       self-id))
                     (reset! !loading? false))))
          (.catchError (fn [err]
                         (reset! !loading? false)
                         (toast/error ctx (str "Жагсаалт татахад алдаа гарлаа: " err))))))))

(defn- schedule-remote-search!
  [ctx q !timer !remote !loading-remote?]
  (when-let [t @!timer]
    (.cancel ^async/Timer t)
    (reset! !timer nil))
  (if (str/blank? (str/trim (str q)))
    (do
      (reset! !remote [])
      (reset! !loading-remote? false))
    (reset! !timer
            (async/Timer. (dc/Duration. .milliseconds 280)
                          (fn []
                            (reset! !timer nil)
                            (search-ctrl/search-users! ctx q !remote !loading-remote?))))))

(defn- toggle-user!
  [!selected-ids !selected-users !step user]
  (let [id (get user "id")]
    (when id
      (if (some #(= % id) @!selected-ids)
        (do
          (swap! !selected-ids (fn [ids] (vec (remove #(= % id) ids))))
          (swap! !selected-users dissoc id)
          (when (and (= @!step :name) (< (count @!selected-ids) 2))
            (reset! !step :pick)))
        (do
          (swap! !selected-ids conj id)
          (swap! !selected-users assoc id user))))))

(defn- submit-group!
  [ctx group-name-ctrl selected-ids !creating?]
  (let [group-name (str/trim (.-text group-name-ctrl))]
    (cond
      (str/blank? group-name)
      (toast/warn ctx "Группийн нэрийг оруулна уу.")

      (< (count selected-ids) 2)
      (toast/warn ctx "Хамгийн багадаа 2 гишүүн сонгоно уу.")

      :else
      (chat-ctrl/create-group! ctx group-name selected-ids !creating?))))

;; =============================================================================
;; 3. Cards
;; =============================================================================

(defn- source-label
  [source]
  (case source
    "recent" "Саяхан"
    "following" "Дагасан"
    nil))

(defn- user-selection-card
  [ctx user {:keys [selected? on-body-tap on-toggle on-remove]}]
  (let [user-id (get user "id")
        name (get user "name" "Unknown")
        handle (get user "handle" "user")
        avatar-url (get user "avatar_url" "")
        label (source-label (get user "source"))]
    (m/GestureDetector
     .onTap on-body-tap
     .onLongPress (or on-toggle on-remove)
     .child
     (m/Container
      .width 120.0
      .margin (m/EdgeInsets.only .right 12.0 .top 16.0 .bottom 16.0)
      .decoration (m/BoxDecoration
                   .color (if selected? (theme/brand-soft ctx) (theme/surface ctx))
                   .borderRadius (m/BorderRadius.circular 16.0)
                   .border (m/Border.all
                            .color (if selected? theme/brand-blue (theme/border ctx))
                            .width (if selected? 2.0 1.0)))
      .padding (m/EdgeInsets.symmetric .vertical 20.0 .horizontal 8.0)
      .child
      (m/Column
       .mainAxisAlignment m/MainAxisAlignment.start
       .crossAxisAlignment m/CrossAxisAlignment.center
       .children
       [(m/GestureDetector
         .onTap (or on-toggle on-remove)
         .behavior m/HitTestBehavior.opaque
         .child
         (m/Container
          .width 28.0 .height 28.0
          .decoration (m/BoxDecoration
                       .shape m/BoxShape.circle
                       .color (if (or selected? on-remove) theme/brand-blue m/Colors.transparent)
                       .border (m/Border.all
                                .color (if (or selected? on-remove) theme/brand-blue (theme/border ctx))
                                .width 2.0))
          .child (if (or selected? on-remove)
                   (m/Icon (if on-remove m/Icons.close_rounded m/Icons.check_rounded)
                           .color m/Colors.white .size 16.0)
                   (m/SizedBox.shrink))))

        (m/SizedBox .height 20.0)
        (smart-avatar/smart-avatar ctx user-id avatar-url :size 56.0 :on-tap on-body-tap)
        (m/SizedBox .height 20.0)

        (m/Expanded
         .child
         (m/Row
          .mainAxisAlignment m/MainAxisAlignment.center
          .crossAxisAlignment m/CrossAxisAlignment.start
          .children
          [(mgl/MongolText name
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 16.0 .color (theme/text ctx))
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)
           (m/SizedBox .width 6.0)
           (mgl/MongolText (str "@" handle)
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 14.0 .color (theme/text-2 ctx))
                           .maxLines 1
                           .overflow m/TextOverflow.ellipsis)]))

        (if label
          (m/Padding
           .padding (m/EdgeInsets.only .top 12.0)
           .child
           (mgl/MongolText label
                           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 12.0 .color theme/brand-blue)))
          (m/SizedBox.shrink))])))))

(defn- selected-chip-row
  [ctx selected-users selected-ids on-remove]
  (let [ordered (vec (keep #(get selected-users %) selected-ids))]
    (m/Container
     .height 56.0
     .margin (m/EdgeInsets.only .top 12.0 .left 16.0)
     .child
     (m/ListView.builder
      .scrollDirection m/Axis.horizontal
      .itemCount (count ordered)
      .itemBuilder
      (fn [_ i]
        (let [user (nth ordered i)
              uid (get user "id")]
          (m/Padding
           .padding (m/EdgeInsets.only .right 10.0)
           .child
           (m/GestureDetector
            .onTap #(on-remove user)
            .child
            (smart-avatar/smart-avatar ctx uid (get user "avatar_url")
                                       :size 40.0
                                       :on-tap #(on-remove user)
                                       :border-width 2.0
                                       :border-color theme/brand-blue)))))))))

(defn- loading-spinner []
  (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue)))

(defn- people-gallery
  [ctx {:keys [pick-step? loading? contacts query loading-remote?
               people naming-people selected-ids selected-users
               on-toggle on-card-tap]}]
  (let [items (if pick-step? people naming-people)
        sel-count (count selected-ids)]
    (cond
      (and loading? (empty? contacts) pick-step?)
      (loading-spinner)

      (and pick-step? (not (str/blank? query)) loading-remote? (empty? people))
      (loading-spinner)

      (and pick-step? (empty? people))
      (if (str/blank? query)
        (empty-state/empty-view ctx
                                :icon-data m/Icons.person_search_rounded
                                :title "Хүн алга"
                                :subtitle "Дагасан эсвэл саяхны хэрэглэгч алга. Хайлт хийнэ үү.")
        (empty-state/empty-search-view ctx query))

      :else
      (m/Column
       .crossAxisAlignment m/CrossAxisAlignment.start
       .children
       (vec
        (keep identity
              [(when (and pick-step? (pos? sel-count))
                 (selected-chip-row ctx selected-users selected-ids on-toggle))
               (m/Expanded
                .child
                (m/ListView.builder
                 .scrollDirection m/Axis.horizontal
                 .physics (m/BouncingScrollPhysics.)
                 .padding (m/EdgeInsets.only .left 16.0 .right 16.0)
                 .itemCount (if (and pick-step? loading-remote?)
                              (inc (count items))
                              (count items))
                 .itemBuilder
                 (fn [_ i]
                   (if (>= i (count items))
                     (m/Center
                      .child
                      (m/Padding
                       .padding (m/EdgeInsets.all 24.0)
                       .child (m/SizedBox .width 24.0 .height 24.0
                                          .child (m/CircularProgressIndicator
                                                  .strokeWidth 2.0
                                                  .color theme/brand-blue))))
                     (let [user (nth items i)
                           uid (get user "id")
                           is-sel? (some #(= % uid) selected-ids)]
                       (user-selection-card
                        ctx user
                        {:selected? is-sel?
                         :on-body-tap (if pick-step?
                                        #(on-card-tap user)
                                        #(on-toggle user))
                         :on-toggle (when pick-step? #(on-toggle user))
                         :on-remove (when-not pick-step? #(on-toggle user))}))))))]))))))

(defn- app-bar-action
  [label on-pressed]
  (m/Padding
   .padding (m/EdgeInsets.only .right 12.0 .top 8.0 .bottom 8.0)
   .child
   (m/ElevatedButton
    .style (m/ElevatedButton.styleFrom
            .backgroundColor theme/brand-blue
            .elevation 0.0
            .shape (m/RoundedRectangleBorder .borderRadius (m/BorderRadius.circular 20.0)))
    .onPressed on-pressed
    .child (m/Text label
                   .style (m/TextStyle .fontFamily "OyunQaganTig"
                                       .fontWeight m/FontWeight.bold
                                       .color m/Colors.white)))))

;; =============================================================================
;; 4. Main screen
;; =============================================================================

(defn new-chat-screen []
  (let [self-id (get @state/current-user "id")
        !contacts (atom [])
        !blocked-ids (atom #{})
        !loading? (atom true)
        !query (atom "")
        !remote (atom [])
        !loading-remote? (atom false)
        !search-timer (atom nil)
        !selected-ids (atom [])
        !selected-users (atom {})
        !step (atom :pick)
        !creating? (atom false)

        apply-query!
        (fn [ctx q]
          (reset! !query q)
          (schedule-remote-search! ctx q !search-timer !remote !loading-remote?))

        cancel-search-timer!
        (fn [_]
          (when-let [t @!search-timer]
            (.cancel ^async/Timer t)
            (reset! !search-timer nil))
          nil)]

    (f/widget
     :context ctx

     :managed [search-ctrl (m/TextEditingController.)
               :dispose .dispose
               group-name-ctrl (m/TextEditingController. .text "")
               :dispose .dispose
               dummy-timer nil
               :dispose cancel-search-timer!]

     :watch [contacts !contacts
             blocked-ids !blocked-ids
             loading? !loading?
             query !query
             remote !remote
             loading-remote? !loading-remote?
             selected-ids !selected-ids
             selected-users !selected-users
             step !step
             creating? !creating?]

     :let [           keyboard-info (merge options/keyboard-option
                                {:keyboard/mongol-font-family "OyunQaganTig"
                                 :keyboard/key-container-color (theme/surface-2 ctx)
                                 :keyboard/font-size 16})
           pick-step? (= step :pick)
           sel-count (count selected-ids)
           people (visible-people contacts remote query blocked-ids self-id)
           naming-people (vec (keep #(get selected-users %) selected-ids))

           open-dm!
           (fn [user]
             (when-not creating?
               (chat-ctrl/open-dm-with-user! ctx (get user "id") (get user "name" "Unknown")
                                             :replace? true)))

           on-toggle!
           (fn [user] (toggle-user! !selected-ids !selected-users !step user))

           on-card-tap!
           (fn [user]
             (if (pos? sel-count)
               (on-toggle! user)
               (open-dm! user)))

           go-name-step!
           (fn []
             (if (< sel-count 2)
               (toast/warn ctx "Хамгийн багадаа 2 гишүүн сонгоно уу.")
               (reset! !step :name)))]

     :bind {:info keyboard-info}

     (pft/PostFrameTrigger
      .onLayout #(load-picker-sources! ctx self-id !contacts !blocked-ids !loading?)
      .child
      (m/Scaffold
       .backgroundColor (theme/bg ctx)
       .resizeToAvoidBottomInset false

       .appBar
       (m/AppBar
        .backgroundColor (theme/surface ctx)
        .elevation 0.5
        .leading (m/IconButton
                  .icon (m/Icon m/Icons.arrow_back_rounded .color (theme/text ctx))
                  .onPressed (fn []
                               (if pick-step?
                                 (nav/pop! ctx)
                                 (reset! !step :pick))))
        .title (m/Text (if pick-step? "Шинэ зурвас" "Шинэ групп")
                       .style (m/TextStyle .fontFamily "OyunQaganTig"
                                           .fontSize 18.0
                                           .fontWeight m/FontWeight.bold
                                           .color (theme/text ctx)))
        .actions
        (vec
         (keep identity
               [(when (and pick-step? (= sel-count 1))
                  (app-bar-action "Зурвас"
                                  #(when-let [user (get selected-users (first selected-ids))]
                                     (open-dm! user))))
                (when (and pick-step? (>= sel-count 2))
                  (app-bar-action (str "Групп (" sel-count ")") go-name-step!))
                (when-not pick-step?
                  (app-bar-action "Үүсгэх"
                                  (if creating?
                                    nil
                                    #(submit-group! ctx group-name-ctrl selected-ids !creating?))))])))

       .body
       (m/SafeArea
        .child
        (m/Column
         .children
         [(m/Expanded
           .child
           (m/Stack
            .children
            [(m/Row
              .crossAxisAlignment m/CrossAxisAlignment.stretch
              .children
              [;; Left rail: search (pick) or group name (name step)
               (m/Container
                .width (if pick-step? 88.0 120.0)
                .padding (m/EdgeInsets.only .top 8.0 .bottom 16.0 .left 8.0 .right 8.0)
                .decoration (m/BoxDecoration
                             .color (theme/surface ctx)
                             .border (m/Border .right (m/BorderSide .color (theme/border ctx) .width 1.0)))
                .child
                (if pick-step?
                  (m/Column
                   .children
                   (vec
                    (keep identity
                          [(m/Expanded
                            .child
                            (search-input/search-field
                             search-ctrl
                             (fn [val]
                               (when-let [t @!search-timer]
                                 (.cancel ^async/Timer t)
                                 (reset! !search-timer nil))
                               (reset! !query val)
                               (if (str/blank? (str/trim (str val)))
                                 (do
                                   (reset! !remote [])
                                   (reset! !loading-remote? false))
                                 (search-ctrl/search-users! ctx val !remote !loading-remote?)))
                             :autofocus false
                             :on-changed #(apply-query! ctx %)
                             :on-clear #(apply-query! ctx "")))
                           (when (pos? sel-count)
                             (m/Padding
                              .padding (m/EdgeInsets.only .top 8.0)
                              .child
                              (mgl/MongolText (str sel-count)
                                              .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                                  .fontSize 13.0
                                                                  .fontWeight m/FontWeight.bold
                                                                  .color theme/brand-blue))))])))
                  (mgl/MongolTextField
                   .controller group-name-ctrl
                   .autofocus true
                   .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0
                                       .fontWeight m/FontWeight.bold .color (theme/text ctx))
                   .decoration (m/InputDecoration
                                .hintText "Группийн нэр..."
                                .hintStyle (m/TextStyle .color (theme/text-2 ctx) .fontWeight m/FontWeight.normal)
                                .border m/InputBorder.none
                                .focusedBorder m/InputBorder.none
                                .enabledBorder m/InputBorder.none))))

               (m/Expanded
                .child
                (people-gallery
                 ctx
                 {:pick-step? pick-step?
                  :loading? loading?
                  :contacts contacts
                  :query query
                  :loading-remote? loading-remote?
                  :people people
                  :naming-people naming-people
                  :selected-ids selected-ids
                  :selected-users selected-users
                  :on-toggle on-toggle!
                  :on-card-tap on-card-tap!}))])
             (keyboard/candidates (m/TextStyle .fontFamily "OyunQaganTig"
                                               .fontSize 16.0
                                               .color (theme/text ctx)))]))
          (keyboard/keyboard {:widget-key (m/ValueKey. "new-chat-kb")})])))))))
