(ns mongol-zangila.ui.profile.change-password
  "Screen for changing user password.
   Utilizes the signature horizontal-scroll vertical-pillar layout for Mongolian typography."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   [clojure.string :as str]

   ;; Infrastructure & Controllers
   [mongol-zangila.infrastructure.api :as api]
   
   ;; UI & Shared Components
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [components.toast :as toast]
   
   ;; Custom Keyboard Wrapper
   [virtual-keyboard.keyboard :as keyboard]
   [virtual-keyboard.options :as options]))

;; =============================================================================
;; 1. Sub-component: Password Input Pillar
;; =============================================================================

(defn- password-input
  "A styled vertical text field optimized for passwords.
   Fixed pillar width so the field is not given unbounded horizontal constraints."
  [^m/TextEditingController ctrl label hint]
  (theme/themed
   (fn [ctx]
     (m/SizedBox
      .width 140.0
      .child
      (m/Padding
       .padding (m/EdgeInsets.only .top 24.0 .bottom 24.0 .right 16.0)
       .child
       (m/Row
        .crossAxisAlignment m/CrossAxisAlignment.start
        .children
        [(mgl/MongolText label
                         .style (m/TextStyle .fontFamily "OyunQaganTig"
                                             .fontSize 15.0
                                             .fontWeight m/FontWeight.bold
                                             .color (theme/text-2 ctx)))
         (m/SizedBox .width 12.0)
         (m/Expanded
          .child
          (mgl/MongolTextField
           .controller ctrl
           .maxLines 1
           .obscureText true
           .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color (theme/text ctx))
           .decoration (m/InputDecoration
                        .hintText hint
                        .hintStyle (m/TextStyle .color (theme/border ctx))
                        .filled true
                        .fillColor (theme/bg ctx)
                        .border (m/OutlineInputBorder
                                 .borderRadius (m/BorderRadius.circular 12.0)
                                 .borderSide m/BorderSide.none))))]))))))

;; =============================================================================
;; 2. Mutation Logic
;; =============================================================================

(defn- submit-password-change!
  [ctx old-pass new-pass confirm-pass !loading?]
  (let [old-trim (str/trim old-pass)
        new-trim (str/trim new-pass)
        confirm-trim (str/trim confirm-pass)]
    
    (cond
      (or (str/blank? old-trim) (str/blank? new-trim) (str/blank? confirm-trim))
      (toast/warn ctx "Талбаруудыг бүрэн бөглөнө үү.") ;; "Please fill all fields"
      
      (< (count new-trim) 6)
      (toast/warn ctx "Шинэ нууц үг хамгийн багадаа 6 тэмдэгт байх ёстой.") ;; "New password must be at least 6 chars"
      
      (not= new-trim confirm-trim)
      (toast/warn ctx "Шинэ нууц үг таарахгүй байна.") ;; "New passwords do not match"
      
      :else
      (do
        (reset! !loading? true)
        (-> (api/post-req "/auth/change-password" {"old_password" old-trim
                                                   "new_password" new-trim})
            (.then (fn [_]
                     (reset! !loading? false)
                     (toast/success ctx "Нууц үг амжилттай солигдлоо.") ;; "Password changed successfully"
                     (nav/pop! ctx)))
            (.catchError (fn [err]
                           (reset! !loading? false)
                           (toast/error ctx "Нууц үг солиход алдаа гарлаа. Хуучин нууц үгээ шалгана уу."))))))))

;; =============================================================================
;; 3. Main Screen Widget
;; =============================================================================

(defn change-password-screen
  "Viewport for updating the user's password securely."
  []
  (let [!loading? (atom false)]

    (f/widget
     :context ctx

     ;; Auto-disposed controllers
     :managed [old-ctrl (m/TextEditingController.)
               new-ctrl (m/TextEditingController.)
               confirm-ctrl (m/TextEditingController.)]
               
     :watch [loading? !loading?]

     :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                :keyboard/key-container-color m/Colors.grey.shade500
                                                :keyboard/font-size 16})]
     :bind {:info info}

     (m/Scaffold
      .backgroundColor (theme/surface ctx)

      ;; --- Top App Bar ---
      .appBar
      (m/AppBar
       .backgroundColor (theme/surface ctx)
       .elevation 0.5
       .leading (m/IconButton
                 .icon (m/Icon m/Icons.arrow_back_ios_new_rounded .color (theme/text ctx) .size 20.0)
                 .onPressed #(nav/pop! ctx))
       .title (m/Text "Нууц үг солих" ;; "Change Password"
                      .style (m/TextStyle .fontFamily "OyunQaganTig"
                                          .fontSize 18.0
                                          .fontWeight m/FontWeight.bold
                                          .color (theme/text ctx)))
       .actions
       [(m/Padding
         .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
         .child
         (m/Container
          .decoration (m/BoxDecoration .color theme/brand-blue .shape m/BoxShape.circle)
          .child
          (m/IconButton
           .icon (if loading?
                   (m/SizedBox .width 16.0 .height 16.0
                               .child (m/CircularProgressIndicator .strokeWidth 2.0 .color m/Colors.white))
                   (m/Icon m/Icons.check_rounded .color m/Colors.white .size 18.0))
           .onPressed (if loading?
                        nil
                        #(submit-password-change!
                          ctx
                          (.-text old-ctrl)
                          (.-text new-ctrl)
                          (.-text confirm-ctrl)
                          !loading?)))))])

      ;; --- Main Body: IME Layout Wrapper ---
      .body
      (m/SafeArea
       .child
       (m/Column
        .children
        [
         ;; Upper Viewport: form + floating candidates bar
         (m/Expanded
          .child
          (m/Stack
           .children
           [
            (m/SingleChildScrollView
             .scrollDirection m/Axis.horizontal
             .padding (m/EdgeInsets.only .left 24.0 .right 48.0 .top 64.0)
             .physics (m/BouncingScrollPhysics.)
             .child
             (m/Row
              .crossAxisAlignment m/CrossAxisAlignment.start
              .children
              [;; Visual Anchor Icon & Text Pillar
               (m/Container
                .alignment m/Alignment.topCenter
                .child
                (m/Column
                 .mainAxisSize m/MainAxisSize.min
                 .children
                 [(m/Container
                   .padding (m/EdgeInsets.all 16.0)
                   .decoration (m/BoxDecoration
                                .color (theme/bg ctx)
                                .shape m/BoxShape.circle)
                   .child (m/Icon m/Icons.lock_outline_rounded .color theme/brand-blue .size 28.0))
                  (m/SizedBox .height 24.0)
                  (mgl/MongolText "Нууц үг солих" ;; Change Password
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                      .fontSize 16.0 
                                                      .fontWeight m/FontWeight.bold 
                                                      .color (theme/text ctx)))]))

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               ;; Old Password Pillar
               (password-input old-ctrl "Хуучин нууц үг" "Одоогийн нууц үг")

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               ;; New Password Pillar
               (password-input new-ctrl "Шинэ нууц үг" "Шинэ нууц үг (6+ тэмдэгт)")

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               ;; Confirm Password Pillar
               (password-input confirm-ctrl "Нууц үг давтах" "Шинэ нууц үгийг дахин оруулна уу")]))

            (keyboard/candidates nil)]))

         ;; Lower Viewport: Custom FST Keyboard
         (keyboard/keyboard {})]))))))