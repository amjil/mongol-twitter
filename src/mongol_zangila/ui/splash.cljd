(ns mongol-zangila.ui.splash
  "Application bootstrap and routing director.
   Presents the initial brand identity while delegating system ignition 
   and session validation to the auth-ctrl domain controller."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]

   ;; Centralized Dart Interop Interceptor
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]

   [cljd.flutter :as f]

   ;; System Controllers
   [mongol-zangila.controllers.auth-ctrl :as auth-ctrl]

   ;; Theme
   [mongol-zangila.ui.theme :as theme]))

;; =============================================================================
;; The Splash Screen Widget
;; =============================================================================

(defn splash-screen
  "The initial view presented to the user while the app boots in the background."
  []
  (f/widget
   :context ctx

   ;; Pure UI Delegation: We hand over the entire boot sequence to the controller.
   ;; The UI component no longer needs to know about sockets, storage, or APIs.
   (pft/PostFrameTrigger
    .onLayout #(auth-ctrl/boot-application! ctx)
    .child
    (m/Scaffold
     .body
     (m/Container
      .decoration (m/BoxDecoration
                   .gradient (m/LinearGradient
                              .begin m/Alignment.topLeft
                              .end m/Alignment.bottomRight
                              .colors [theme/brand-blue theme/brand-blue-deep]))
      .child
      (m/Center
       .child
       (m/Row
        .mainAxisAlignment m/MainAxisAlignment.center
        .crossAxisAlignment m/CrossAxisAlignment.center
        .children
        [(m/Container
          .padding (m/EdgeInsets.all 20.0)
          .decoration (m/BoxDecoration
                       .color (.withOpacity m/Colors.white 0.15)
                       .shape m/BoxShape.circle)
          .child (m/Icon m/Icons.water_drop_rounded .color m/Colors.white .size 36.0))
         (m/SizedBox .width 28.0)
         (mgl/MongolText "Монгол Зангилаа"
                         .style (m/TextStyle .fontFamily "OyunQaganTig"
                                             .fontSize 36.0
                                             .fontWeight m/FontWeight.bold
                                             .color m/Colors.white
                                             .letterSpacing 2.0))
         (m/SizedBox .width 48.0)
         (m/CircularProgressIndicator
          .valueColor (m/AlwaysStoppedAnimation. m/Colors.white)
          .strokeWidth 3.0)])))))))