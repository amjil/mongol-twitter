(ns mongol-zangila.ui.notifications.view
  "Notifications viewport.
   Renders incoming social metrics (likes, follows, mentions, reposts, quotes) as vertical pillars
   and cleanly triggers instant global unread flushes upon viewport entry.
   ⚡ Upgraded with Infinite Scroll Pagination, Timestamps, and Content Previews."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   
   ;; Centralized Dart Interop Interceptor
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   
   [cljd.flutter :as f]
   [clojure.string :as str]
   
   ;; System Controllers & UI Components
   [mongol-zangila.controllers.notification-ctrl :as note-ctrl]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.layout.scaffold :as scaffold] ;; ⚡ Import the new global layout
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]))

;; =============================================================================
;; 1. Helper Functions
;; =============================================================================

(defn- format-note-time 
  "Parses an ISO 8601 string into a readable MM-dd HH:mm format."
  [iso-string]
  (if (str/blank? iso-string) 
    ""
    (try
      (let [dt (dc/DateTime.parse iso-string)
            M (.padLeft (.toString (.month dt)) 2 "0")
            d (.padLeft (.toString (.day dt)) 2 "0")
            h (.padLeft (.toString (.hour dt)) 2 "0")
            m-min (.padLeft (.toString (.minute dt)) 2 "0")]
        (str M "-" d " " h ":" m-min))
      (catch dc/Exception _ ""))))

;; =============================================================================
;; 2. Sub-components
;; =============================================================================

(defn- on-notification-tap
  "Routes to the relevant post or user profile based on notification type."
  [ctx note-data]
  (let [note-type (get note-data "type")
        entity-id (get note-data "entity_id")
        actor-id (get-in note-data ["actor" "id"])]
    (cond
      (#{"like" "mention" "repost" "quote"} note-type)
      (when entity-id (nav/push! ctx "/feed/post-detail" {:post-id entity-id}))

      (= note-type "follow")
      (when actor-id (nav/push! ctx "/profile/view" {:user-id actor-id}))

      :else nil)))

(defn- notification-pillar
  "Renders an individual notification metadata card wrapped as an LTR horizontal entry."
  [ctx note-data]
  (let [actor (get note-data "actor" {})
        actor-name (get actor "name" "Хэрэглэгч")
        note-type (get note-data "type" "system")
        timestamp (get note-data "created_at" "") ;; ⚡ Extract created_at
        
        ;; ⚡ Extract comment, mention body, or original-post snippet from the backend
        preview-text (get note-data "content" "")
        has-preview? (and (#{"mention" "quote" "repost" "like"} note-type) 
                          (not (str/blank? preview-text)))
        
        message (case note-type
                  "like" "таны нийтлэлд лайк дарлаа." ;; "liked your post"
                  "follow" "таныг дагаж эхэллээ."    ;; "started following you"
                  "mention" "таныг нийтлэлдээ дурдлаа." ;; "mentioned you"
                  "repost" "таны нийтлэлийг дахин нийтэллээ." ;; "reposted your post"
                  "quote" "таны нийтлэлийг иш татлаа." ;; "quoted your post"
                  "Таныд мэдэгдэл ирлээ.")]
    (m/Container
     .margin (m/EdgeInsets.only .right 16.0 .top 16.0 .bottom 16.0)
     .decoration (m/BoxDecoration 
                  .color (theme/surface ctx)
                  .borderRadius (m/BorderRadius.circular 16.0)
                  .border (m/Border.all .color (theme/border ctx) .width 0.5))
     .child
     (m/InkWell
      .onTap #(on-notification-tap ctx note-data)
      .borderRadius (m/BorderRadius.circular 16.0)
      .child
      (m/Padding
       .padding (m/EdgeInsets.all 16.0)
       .child
       (m/Column
        .mainAxisSize m/MainAxisSize.min
        .crossAxisAlignment m/CrossAxisAlignment.start
        .children
        [(smart-avatar/smart-avatar ctx (get actor "id") (get actor "avatar_url") :size 40.0)
         (m/SizedBox .height 16.0)
         
         ;; 1. Notification action description
         (mgl/MongolText (str actor-name " " message)
                         .maxLines 2
                         .overflow m/TextOverflow.ellipsis
                         .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                             .fontSize 15.0 
                                             .fontWeight m/FontWeight.bold
                                             .color (theme/text ctx)))
         
         ;; 2. If there is a repost body, quoted comment, or mention, render a light preview bubble
         (if has-preview?
           (m/Padding
            .padding (m/EdgeInsets.only .top 12.0)
            .child
            (m/Container
             .padding (m/EdgeInsets.all 10.0)
             .decoration (m/BoxDecoration
                          .color (.withOpacity theme/brand-blue 0.04)
                          .borderRadius (m/BorderRadius.circular 10.0)
                          .border (m/Border.all .color (theme/border ctx) .width 0.5))
             .child
             (mgl/MongolText preview-text
                             .maxLines 3
                             .overflow m/TextOverflow.ellipsis
                             .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                 .fontSize 13.0
                                                 .height 1.3
                                                 .color (theme/text-2 ctx)))))
           (m/SizedBox.shrink))
         
         (m/SizedBox .height 12.0)
         
         ;; 3. Timestamp
         (mgl/MongolText (format-note-time timestamp)
                         .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                             .fontSize 12.0 
                                             .color (theme/text-2 ctx)))]))))))

;; =============================================================================
;; 3. The Main Screen Widget
;; =============================================================================

(defn notifications-screen
  "The primary viewport for active notification streams."
  []
  (let [!notifications (atom [])
        !loading? (atom true)
        
        ;; ⚡ Pagination state
        !page (atom 1)
        !has-more? (atom true)
        !loading-more? (atom false)]
    
    (f/widget
     :context ctx
     
     ;; ⚡ Init ScrollController and listen for near-end scroll
     :managed [scroll-ctrl (let [sc (m/ScrollController.)]
                             (.addListener sc 
                                           (fn []
                                             (let [pos (.-position sc)]
                                               ;; Prefetch the next page when within 200 px of the end
                                               (when (and (>= (.-pixels pos) (- (.-maxScrollExtent pos) 200.0))
                                                          (not @!loading-more?)
                                                          @!has-more?)
                                                 (note-ctrl/load-notifications! ctx !notifications !page !has-more? !loading-more? false)))))
                             sc)
               :dispose .dispose]
               
     :watch [notifications !notifications
             loading? !loading?
             has-more? !has-more?]
     
     (pft/PostFrameTrigger
      .onLayout (fn []
                  ;; 1. Fetch notifications over HTTP (controller must accept pagination args)
                  (-> (note-ctrl/load-notifications! ctx !notifications !page !has-more? !loading? true)
                      (.then (fn [_]
                               ;; 2. On success, mark all as read (zero the global atom and sync the backend)
                               (note-ctrl/mark-all-read!)))))
      .child
      
      ;; Core swap: app-scaffold fully owns the global Bottom Navigation Bar
      (scaffold/app-scaffold
       ctx "/notifications/view"
       (m/Scaffold
        .backgroundColor (theme/bg ctx)
        
        .appBar
        (m/AppBar
         .backgroundColor (theme/surface ctx)
         .elevation 0.5
         ;; Top-level bottom-nav tab: no back button
         .automaticallyImplyLeading false
         .title (m/Text "Мэдэгдэл" ;; "Notifications"
                        .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                            .fontSize 18.0 
                                            .fontWeight m/FontWeight.bold 
                                            .color (theme/text ctx))))
        
        .body
        (if loading?
          (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))
          (if (empty? notifications)
            (m/Center .child (mgl/MongolText "Мэдэгдэл хоосон байна." .style (m/TextStyle .fontFamily "OyunQaganTig" .color (theme/text-2 ctx))))
            
            (m/ListView.builder
             .controller scroll-ctrl ;; ⚡ Bind the scroll controller
             .scrollDirection m/Axis.horizontal
             ;; Force scroll physics even when there is little data
             .physics (m/AlwaysScrollableScrollPhysics. .parent (m/BouncingScrollPhysics.))
             .padding (m/EdgeInsets.symmetric .horizontal 16.0)
             
             ;; ⚡ Reserve a slot for the loading spinner
             .itemCount (if has-more? (inc (count notifications)) (count notifications))
             
             .itemBuilder 
             (fn [_ i] 
               ;; ⚡ Show a spinner when rendering the extra sentinel index
               (if (= i (count notifications))
                 (m/Padding 
                  .padding (m/EdgeInsets.only .right 24.0 .left 24.0)
                  .child (m/Center .child (m/SizedBox .width 24.0 .height 24.0 
                                                      .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/brand-blue))))
                 
                 (notification-pillar ctx (nth notifications i)))))))))))))