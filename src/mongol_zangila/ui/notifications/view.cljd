(ns mongol-zangila.ui.notifications.view
  "Notifications viewport.
   Renders incoming social metrics (likes, follows, mentions, reposts, quotes) as vertical pillars
   and cleanly triggers instant global unread flushes upon viewport entry."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   ["package:custom_refresh_indicator/custom_refresh_indicator.dart" :as cri]
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]

   [cljd.flutter :as f]
   [clojure.string :as str]

   [mongol-zangila.controllers.notification-ctrl :as note-ctrl]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.utils.time-format :as time-format]
   [mongol-zangila.ui.layout.scaffold :as scaffold]
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]
   [mongol-zangila.ui.widgets.empty-state :as empty-state]
   [pull-to-refresh.refresh :as ptr]))

;; =============================================================================
;; 1. Sub-components
;; =============================================================================

(defn- on-notification-tap
  "Routes to the relevant post or user profile based on notification type."
  [ctx note-data]
  (let [note-type (get note-data "type")
        entity-id (get note-data "entity_id")
        actor-id (get-in note-data ["actor" "id"])]
    (cond
      (#{"like" "mention" "repost" "quote"} note-type)
      (when entity-id (nav/push! ctx "/feed/post-detail" {:post-id entity-id}))

      (= note-type "follow")
      (when actor-id (nav/push! ctx "/profile/view" {:user-id actor-id}))

      :else nil)))

(defn- note-unread?
  [note-data]
  (not (or (get note-data "is_read")
           (get note-data "read")
           (get note-data "seen"))))

(defn- notification-pillar
  "Fixed-width vertical pillar. Text lives in Expanded so MongolText can wrap and ellipsize."
  [ctx note-data]
  (let [actor (get note-data "actor" {})
        actor-name (get actor "name" "Хэрэглэгч")
        note-type (get note-data "type" "system")
        timestamp (get note-data "created_at" "")
        preview-text (get note-data "content" "")
        has-preview? (and (#{"mention" "quote" "repost" "like"} note-type)
                          (not (str/blank? preview-text)))
        unread? (note-unread? note-data)
        message (case note-type
                  "like" "таны нийтлэлд лайк дарлаа."
                  "follow" "таныг дагаж эхэллээ."
                  "mention" "таныг нийтлэлдээ дурдлаа."
                  "repost" "таны нийтлэлийг дахин нийтэллээ."
                  "quote" "таны нийтлэлийг иш татлаа."
                  "Таныд мэдэгдэл ирлээ.")
        action-text (str actor-name " " message)]
    (m/Container
     .width 180.0
     .margin (m/EdgeInsets.only .top 16.0 .bottom 16.0)
     .clipBehavior m/Clip.antiAlias
     .decoration (m/BoxDecoration
                  .color (if unread? (theme/surface ctx) (theme/bg ctx))
                  .borderRadius (m/BorderRadius.circular theme/radius-md)
                  .border (m/Border.all .color (theme/border ctx) .width 0.5))
     .child
     (m/Material
      .color m/Colors.transparent
      .child
      (m/InkWell
       .onTap #(on-notification-tap ctx note-data)
       .borderRadius (m/BorderRadius.circular theme/radius-md)
       .child
       (m/Padding
        .padding (m/EdgeInsets.all 16.0)
        .child
        (m/Column
         .crossAxisAlignment m/CrossAxisAlignment.start
         .children
         [(smart-avatar/smart-avatar ctx (get actor "id") (get actor "avatar_url") :size 40.0)
          (m/SizedBox .height 16.0)

          (m/Expanded
           .child
           (if has-preview?
             (m/Column
              .crossAxisAlignment m/CrossAxisAlignment.start
              .children
              [(m/Flexible
                .flex 2
                .child
                (mgl/MongolText action-text
                                .maxLines 2
                                .overflow m/TextOverflow.ellipsis
                                .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                    .fontSize 15.0
                                                    .fontWeight (if unread? m/FontWeight.bold m/FontWeight.w500)
                                                    .color (theme/text ctx))))
               (m/SizedBox .height 12.0)
               (m/Expanded
                .flex 3
                .child
                (m/Container
                 .width double/infinity
                 .padding (m/EdgeInsets.all 10.0)
                 .decoration (m/BoxDecoration
                              .color (theme/brand-soft ctx)
                              .borderRadius (m/BorderRadius.circular 10.0)
                              .border (m/Border.all .color (theme/border ctx) .width 0.5))
                 .child
                 (mgl/MongolText preview-text
                                 .maxLines 3
                                 .overflow m/TextOverflow.ellipsis
                                 .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                     .fontSize 13.0
                                                     .height 1.3
                                                     .color (theme/text-2 ctx)))))])
             (mgl/MongolText action-text
                             .maxLines 2
                             .overflow m/TextOverflow.ellipsis
                             .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                 .fontSize 15.0
                                                 .fontWeight (if unread? m/FontWeight.bold m/FontWeight.w500)
                                                 .color (theme/text ctx)))))

          (m/SizedBox .height 12.0)

          (mgl/MongolText (time-format/format-relative timestamp)
                          .style (m/TextStyle .fontFamily "OyunQaganTig"
                                              .fontSize 12.0
                                              .fontWeight (if unread? m/FontWeight.bold m/FontWeight.normal)
                                              .color (if unread? theme/brand-blue (theme/text-2 ctx))))])))))))

;; =============================================================================
;; 2. The Main Screen Widget
;; =============================================================================

(defn- apply-load-result!
  [ok is-refresh? !error? !notifications]
  (if ok
    (do (reset! !error? false)
        (when is-refresh? (note-ctrl/mark-all-read!)))
    (when (empty? @!notifications)
      (reset! !error? true))))

(defn notifications-screen
  "The primary viewport for active notification streams."
  []
  (let [!notifications (atom [])
        !loading? (atom true)
        !error? (atom false)
        !page (atom 1)
        !has-more? (atom true)
        !loading-more? (atom false)
        !refresh-loading? (atom false)]

    (f/widget
     :context ctx

     :managed [scroll-ctrl (let [sc (m/ScrollController.)]
                             (.addListener sc
                                           (fn []
                                             (let [pos (.-position sc)]
                                               (when (and (>= (.-pixels pos) (- (.-maxScrollExtent pos) 200.0))
                                                          (not @!loading-more?)
                                                          (not @!refresh-loading?)
                                                          @!has-more?)
                                                 (-> (note-ctrl/load-notifications! ctx !notifications !page !has-more? !loading-more? false)
                                                     (.then (fn [ok] (apply-load-result! ok false !error? !notifications))))))))
                             sc)
               :dispose .dispose]

     :watch [notifications !notifications
             loading? !loading?
             error? !error?
             has-more? !has-more?
             loading-more? !loading-more?]

     (let [reload! (fn [!loading-atom]
                     (reset! !error? false)
                     (-> (note-ctrl/load-notifications! ctx !notifications !page !has-more? !loading-atom true)
                         (.then (fn [ok] (apply-load-result! ok true !error? !notifications)))))]

       (pft/PostFrameTrigger
        .onLayout #(reload! !loading?)
        .child

        (scaffold/app-scaffold
         ctx "/notifications/view"
         (m/Scaffold
          .backgroundColor (theme/bg ctx)

          .appBar
          (m/AppBar
           .backgroundColor (theme/surface ctx)
           .elevation 0.5
           .automaticallyImplyLeading false
           .title (m/Text "Мэдэгдэл"
                          .style (m/TextStyle .fontFamily "OyunQaganTig"
                                              .fontSize 18.0
                                              .fontWeight m/FontWeight.bold
                                              .color (theme/text ctx))))

          .body
          (cond
            loading?
            (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))

            (and error? (empty? notifications))
            (empty-state/offline-view ctx #(reload! !loading?))

            (empty? notifications)
            (empty-state/empty-view ctx
                                    :icon-data m/Icons.notifications_none_rounded
                                    :title "Мэдэгдэл хоосон байна"
                                    :subtitle "Шинэ лайк, дагагч энд харагдана.")

            :else
            (ptr/horizontal-refresh
             {:on-refresh #(reload! !refresh-loading?)
              :scroll-controller scroll-ctrl
              :background-color (theme/bg ctx)
              :not-armed-text "Татаж шинэчлэх"
              :armed-text "Суллаж шинэчлэх"
              :loading-text "Шинэчилж байна"
              :not-armed-color (theme/border ctx)
              :armed-color theme/brand-blue
              :text-style (m/TextStyle .fontFamily "OyunQaganTig" .color m/Colors.white .fontSize 14.0 .fontWeight m/FontWeight.bold)
              :trigger-mode cri/IndicatorTriggerMode.anywhere
              :item-count (if (and has-more? loading-more?)
                            (inc (count notifications))
                            (count notifications))
              :separator-builder (fn [_ _] (m/SizedBox .width 8.0))
              :box-shadow []
              :item-builder
              (fn [_ i]
                (if (and loading-more? (= i (count notifications)))
                  (m/Padding
                   .padding (m/EdgeInsets.symmetric .horizontal 24.0)
                   .child (m/Center .child (m/SizedBox .width 24.0 .height 24.0
                                                       .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/brand-blue))))
                  (m/Padding
                   .padding (m/EdgeInsets.only
                             .left (if (zero? i) 16.0 0.0)
                             .right (if (= i (dec (count notifications))) 16.0 0.0))
                   .child (notification-pillar ctx (nth notifications i)))))})))))))))
