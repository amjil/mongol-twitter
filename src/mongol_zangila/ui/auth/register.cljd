(ns mongol-zangila.ui.auth.register
  "Registration screen viewport.
   A purely declarative UI layer delegating account creation and 
   OTP routing to the auth-ctrl domain controller.
   ⚡ Refactored to native vertical Mongolian layout with custom keyboard."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   
   ;; System Controllers
   [mongol-zangila.controllers.auth-ctrl :as auth-ctrl]
   
   ;; UI & Utilities
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.infrastructure.storage :as storage]
   [mongol-zangila.ui.widgets.auth-components :as auth-ui]
   [mongol-zangila.utils.nav :as nav]
   
   ;; Custom Keyboard (IME wrapper)
   [mongol-zangila.ui.widgets.ime-wrapper :as ime]))

(defn register-screen 
  "The primary account creation gateway."
  []
  (let [!loading? (atom false)]
    
    (f/widget
     :context ctx
     
     :managed [name-ctrl (m/TextEditingController.)
               phone-ctrl (m/TextEditingController.)
               pass-ctrl (m/TextEditingController.)]

     :watch [standard-ime? storage/!standard-ime?]
     :let [info (auth-ui/keyboard-options standard-ime?)]
     :bind {:info info}
     
     (m/Scaffold
      .backgroundColor (theme/surface ctx)
      
      .appBar
      (m/AppBar
       .backgroundColor (theme/surface ctx)
       .elevation 0.5
       .leading (m/IconButton 
                 .icon (m/Icon m/Icons.arrow_back_rounded .color (theme/text ctx))
                 .onPressed #(nav/pop! ctx))
       .title (mgl/MongolText "Бүртгүүлэх"
                              .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                  .fontSize 18.0 
                                                  .fontWeight m/FontWeight.bold 
                                                  .color (theme/text ctx))))
      
      .body
      (m/SafeArea
       .child
       (m/Column
        .children
        [
         (m/Expanded
          .child
          (ime/dismiss-zone
           (m/Stack
            .children
            [(m/SingleChildScrollView
              .scrollDirection m/Axis.horizontal
              .padding (m/EdgeInsets.only .left 24.0 .right 48.0 .top 64.0)
              .physics (m/BouncingScrollPhysics.)
              .child
              (m/Row
               .crossAxisAlignment m/CrossAxisAlignment.start
               .children
               [
                (m/Container
                 .width 140.0
                 .padding (m/EdgeInsets.only .top 24.0)
                 .alignment m/Alignment.topCenter
                 .child
                 (m/Column
                  .mainAxisSize m/MainAxisSize.min
                  .children
                  [(m/Container
                    .padding (m/EdgeInsets.all 16.0)
                    .decoration (m/BoxDecoration .color (theme/bg ctx) .shape m/BoxShape.circle)
                    .child (m/Icon m/Icons.person_add_alt_1_rounded .color theme/brand-blue .size 28.0))
                   (m/SizedBox .height 24.0)
                   (mgl/MongolText "Бүртгүүлэх"
                                   .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                       .fontSize 16.0 
                                                       .fontWeight m/FontWeight.bold 
                                                       .color (theme/text ctx)))]))

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               (auth-ui/auth-input-pillar name-ctrl "Нэр")

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               (auth-ui/auth-input-pillar phone-ctrl "Утасны дугаар")

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               (auth-ui/auth-input-pillar pass-ctrl "Нууц үг" :obscure? true)

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

               (m/Padding
                .padding (m/EdgeInsets.only .top 24.0 .right 24.0)
                .child
                (m/Row
                 .crossAxisAlignment m/CrossAxisAlignment.start
                 .children
                 [
                  (auth-ui/auth-submit-button
                   !loading?
                   #(auth-ctrl/request-otp-registration!
                     ctx
                     (.-text phone-ctrl)
                     (.-text name-ctrl)
                     (.-text pass-ctrl)
                     !loading?))
                  
                  (m/SizedBox .width 32.0)
                  
                  (mgl/MongolText "Бүртгүүлснээр та манай Үйлчилгээний нөхцөлийг\nзөвшөөрсөнд тооцно."
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                      .fontSize 13.0 
                                                      .color (theme/text-2 ctx)
                                                      .height 1.5))]))]))
             
             (ime/candidates-overlay nil)])))

         (ime/animated-keyboard {})]))))))
