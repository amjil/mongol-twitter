(ns mongol-zangila.ui.auth.forgot-password
  "Forgot password screen viewport.
   ⚡ Refactored to native vertical Mongolian layout with custom keyboard."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   
   ;; System Controllers
   [mongol-zangila.controllers.auth-ctrl :as auth-ctrl]
   
   ;; UI & Utilities
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   
   ;; Custom Keyboard
   [virtual-keyboard.keyboard :as keyboard]
   [virtual-keyboard.options :as options]))

;; =============================================================================
;; 1. Sub-component: Auth Input Pillar
;; =============================================================================

(defn- auth-input-pillar 
  "A styled vertical text input column for phone numbers."
  [^m/TextEditingController ctrl label]
  (m/Container
   .padding (m/EdgeInsets.only .top 24.0 .bottom 24.0 .right 24.0)
   .child
   (m/Row
    .crossAxisAlignment m/CrossAxisAlignment.start
    .children
    [;; Vertical Label
     (mgl/MongolText label
                     .style (m/TextStyle .fontFamily "OyunQaganTig"
                                         .fontSize 15.0
                                         .fontWeight m/FontWeight.bold
                                         .color theme/text-secondary))
     (m/SizedBox .width 16.0)
     
     ;; Native Vertical Input Field
     (mgl/MongolTextField
      .controller ctrl
      .maxLines 1
      .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color theme/text-primary)
      .decoration (m/InputDecoration
                   .hintStyle (m/TextStyle .color theme/border-color)
                   .filled true
                   .fillColor theme/bg-color
                   .border (m/OutlineInputBorder
                            .borderRadius (m/BorderRadius.circular 12.0)
                            .borderSide m/BorderSide.none)))])))

;; =============================================================================
;; 2. Main Screen
;; =============================================================================

(defn forgot-password-screen 
  []
  (let [!loading? (atom false)]
    
    (f/widget
     :context ctx
     :managed [phone-ctrl (m/TextEditingController.)]
     :watch [loading? !loading?]
     
     :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                :keyboard/key-container-color m/Colors.grey.shade500
                                                :keyboard/font-size 16})]
     :bind {:info info}
     
     (m/Scaffold
      .backgroundColor m/Colors.white
      
      .appBar
      (m/AppBar
       .backgroundColor m/Colors.white
       .elevation 0.5
       .leading (m/IconButton 
                 .icon (m/Icon m/Icons.arrow_back_rounded .color theme/text-primary)
                 .onPressed #(nav/pop! ctx))
       .title (mgl/MongolText "Нууц үг сэргээх"
                              .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                  .fontSize 18.0 
                                                  .fontWeight m/FontWeight.bold 
                                                  .color theme/text-primary)))
      
      .body
      (m/SafeArea
       .child
       (m/Column
        .children
        [
         ;; A. Main Viewport
         (m/Expanded
          .child
          (m/Stack
           .children
           [(m/SingleChildScrollView
             .scrollDirection m/Axis.horizontal
             .padding (m/EdgeInsets.only .left 24.0 .right 48.0 .top 64.0)
             .physics (m/BouncingScrollPhysics.)
             .child
             (m/Row
              .crossAxisAlignment m/CrossAxisAlignment.start
              .children
              [;; Visual Anchor Pillar
               (m/Container
                .width 140.0
                .padding (m/EdgeInsets.only .top 24.0)
                .alignment m/Alignment.topCenter
                .child
                (m/Column
                 .children
                 [(m/Container
                   .padding (m/EdgeInsets.all 16.0)
                   .decoration (m/BoxDecoration .color theme/bg-color .shape m/BoxShape.circle)
                   .child (m/Icon m/Icons.lock_reset_rounded .color theme/brand-blue .size 28.0))
                  (m/SizedBox .height 24.0)
                  (mgl/MongolText "Нууц үг сэргээх" 
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontWeight m/FontWeight.bold .fontSize 16.0))
                  (m/SizedBox .height 16.0)
                  (mgl/MongolText "Утасны дугаараа оруулна уу." 
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 13.0 .color theme/text-secondary))]))

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/border-color)

               ;; Input Pillar
               (auth-input-pillar phone-ctrl "Утасны дугаар")
               
               ;; Action Pillar
               (m/Padding
                .padding (m/EdgeInsets.only .top 24.0 .right 24.0)
                .child
                (m/Container
                 .decoration (m/BoxDecoration .color theme/brand-blue .shape m/BoxShape.circle)
                 .child
                 (m/IconButton
                  .icon (if loading?
                          (m/SizedBox .width 16.0 .height 16.0 
                                      .child (m/CircularProgressIndicator .strokeWidth 2.0 .color m/Colors.white))
                          (m/Icon m/Icons.arrow_forward_rounded .color m/Colors.white .size 18.0))
                  .onPressed (if loading? 
                               nil 
                               #(auth-ctrl/request-password-reset-otp! ctx (.-text phone-ctrl) !loading?)))))]))
            
            (keyboard/candidates nil)]))

         ;; B. Keyboard
         (keyboard/keyboard {})]))))))