(ns mongol-zangila.ui.auth.reset-password
  "Password reset confirmation screen viewport.
   A purely declarative UI layer delegating the final password update 
   to the auth-ctrl domain controller.
   ⚡ Refactored to native vertical Mongolian layout with custom keyboard."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   
   ;; System Controllers
   [mongol-zangila.controllers.auth-ctrl :as auth-ctrl]
   
   ;; UI & Utilities
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.ui.widgets.auth-components :as auth-ui]
   [mongol-zangila.utils.nav :as nav]
   [components.toast :as toast]
   
   ;; Custom Keyboard (IME wrapper)
   [mongol-zangila.ui.widgets.ime-wrapper :as ime]))

(defn reset-password-screen 
  "The final view in the password recovery flow where the user sets a new password.
   Requires phone and OTP code from the verification step."
  [phone code]
  (let [!loading? (atom false)]
    
    (f/widget
     :context ctx
     
     :managed [pass-ctrl (m/TextEditingController.)
               confirm-ctrl (m/TextEditingController.)]
     
     :let [info auth-ui/shared-keyboard-options]
     :bind {:info info}

     (m/Scaffold
      .backgroundColor (theme/surface ctx)
      
      .appBar
      (m/AppBar
       .backgroundColor (theme/surface ctx)
       .elevation 0.5
       .leading (m/IconButton 
                 .icon (m/Icon m/Icons.arrow_back_ios_new_rounded .color (theme/text ctx) .size 20.0)
                 .onPressed #(nav/pop! ctx))
       .title (mgl/MongolText "Шинэ нууц үг"
                              .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                  .fontSize 18.0
                                                  .fontWeight m/FontWeight.bold
                                                  .color (theme/text ctx)))
       .actions
       [(m/Padding
         .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
         .child
         (auth-ui/auth-submit-button
          !loading?
          (fn []
            (let [p1 (.-text pass-ctrl)
                  p2 (.-text confirm-ctrl)]
              (if (not= p1 p2)
                (toast/warn ctx "Нууц үг таарахгүй байна.")
                (auth-ctrl/submit-new-password! ctx phone code p1 !loading?))))
          :icon (m/Icon m/Icons.check_rounded .color m/Colors.white .size 18.0)))])
      
      .body
      (m/SafeArea
       .child
       (m/Column
        .children
        [
         (m/Expanded
          .child
          (ime/dismiss-zone
           (m/Stack
            .children
            [
             (m/SingleChildScrollView
              .scrollDirection m/Axis.horizontal
              .padding (m/EdgeInsets.only .left 24.0 .right 48.0 .top 64.0)
              .physics (m/BouncingScrollPhysics.)
              .child
              (m/Row
               .crossAxisAlignment m/CrossAxisAlignment.start
               .children
               [
                (m/Container
                 .width 140.0
                 .padding (m/EdgeInsets.only .top 24.0)
                 .alignment m/Alignment.topCenter
                 .child
                 (m/Column
                  .mainAxisSize m/MainAxisSize.min
                  .children
                  [(m/Container
                    .padding (m/EdgeInsets.all 16.0)
                    .decoration (m/BoxDecoration
                                 .color (theme/bg ctx)
                                 .shape m/BoxShape.circle)
                    .child (m/Icon m/Icons.lock_outline_rounded .color theme/brand-blue .size 28.0))
                   (m/SizedBox .height 24.0)
                   (mgl/MongolText "Шинэ нууц үг"
                                   .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                       .fontSize 16.0 
                                                       .fontWeight m/FontWeight.bold 
                                                       .color (theme/text ctx)))
                   (m/SizedBox .height 16.0)
                   (mgl/MongolText "Та шинэ нууц үгээ оруулна уу."
                                   .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                       .fontSize 13.0 
                                                       .color (theme/text-2 ctx)))]))

                (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

                (auth-ui/auth-input-pillar pass-ctrl "Шинэ нууц үг" :obscure? true)
                
                (m/VerticalDivider .width 1.0 .thickness 1.0 .color (theme/border ctx))

                (auth-ui/auth-input-pillar confirm-ctrl "Нууц үг давтах" :obscure? true)]))
             
             (ime/animated-candidates nil)])))

         (ime/animated-keyboard {})]))))))
