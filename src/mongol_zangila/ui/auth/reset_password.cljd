(ns mongol-zangila.ui.auth.reset-password
  "Password reset confirmation screen viewport.
   A purely declarative UI layer delegating the final password update 
   to the auth-ctrl domain controller.
   ⚡ Refactored to native vertical Mongolian layout with custom keyboard."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:mongol/mongol.dart" :as mgl]
   [cljd.flutter :as f]
   
   ;; System Controllers
   [mongol-zangila.controllers.auth-ctrl :as auth-ctrl]
   
   ;; UI & Utilities
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [components.toast :as toast]
   
   ;; Custom Keyboard Wrapper
   [virtual-keyboard.keyboard :as keyboard]
   [virtual-keyboard.options :as options]))

;; =============================================================================
;; 1. Sub-component: Password Input Pillar
;; =============================================================================

(defn- auth-input-pillar 
  "A styled vertical text field optimized for authentication forms.
   Ensures text is obscured (hidden as dots)."
  [^m/TextEditingController ctrl label]
  (m/Container
   .padding (m/EdgeInsets.only .top 24.0 .bottom 24.0 .right 24.0)
   .child
   (m/Row
    .crossAxisAlignment m/CrossAxisAlignment.start
    .children
    [;; Vertical Label
     (mgl/MongolText label
                     .style (m/TextStyle .fontFamily "OyunQaganTig"
                                         .fontSize 15.0
                                         .fontWeight m/FontWeight.bold
                                         .color theme/text-secondary))
     (m/SizedBox .width 16.0)

     ;; Obscured Vertical Input Field
     (mgl/MongolTextField
      .controller ctrl
      .maxLines 1
      .obscureText true
      .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 16.0 .color theme/text-primary)
      .decoration (m/InputDecoration
                   .hintStyle (m/TextStyle .color theme/border-color)
                   .filled true
                   .fillColor theme/bg-color
                   .border (m/OutlineInputBorder
                            .borderRadius (m/BorderRadius.circular 12.0)
                            .borderSide m/BorderSide.none)))])))

;; =============================================================================
;; 2. The Main Reset Password Screen Widget
;; =============================================================================

(defn reset-password-screen 
  "The final view in the password recovery flow where the user sets a new password.
   Requires phone and OTP code from the verification step."
  [phone code]
  (let [!loading? (atom false)]
    
    (f/widget
     :context ctx
     
     ;; ⚡ Automatic disposal of text controllers
     :managed [pass-ctrl (m/TextEditingController.)
               confirm-ctrl (m/TextEditingController.)]
     :watch [loading? !loading?]
     
     ;; Keyboard options injection
     :let [info (merge options/keyboard-option {:keyboard/mongol-font-family "OyunQaganTig"
                                                :keyboard/key-container-color m/Colors.grey.shade500
                                                :keyboard/font-size 16})]
     :bind {:info info}

     (m/Scaffold
      .backgroundColor m/Colors.white
      
      ;; --- Top App Bar ---
      .appBar
      (m/AppBar
       .backgroundColor m/Colors.white
       .elevation 0.5
       .leading (m/IconButton 
                 .icon (m/Icon m/Icons.arrow_back_ios_new_rounded .color theme/text-primary .size 20.0)
                 .onPressed #(nav/pop! ctx))
       .title (mgl/MongolText "Шинэ нууц үг" ;; "New Password"
                              .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                  .fontSize 18.0
                                                  .fontWeight m/FontWeight.bold
                                                  .color theme/text-primary))
       .actions
       [(m/Padding
         .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
         .child
         (m/Container
          .decoration (m/BoxDecoration .color theme/brand-blue .shape m/BoxShape.circle)
          .child
          (m/IconButton
           .icon (if loading?
                   (m/SizedBox .width 16.0 .height 16.0 
                               .child (m/CircularProgressIndicator .strokeWidth 2.0 .color m/Colors.white))
                   (m/Icon m/Icons.check_rounded .color m/Colors.white .size 18.0))
           .onPressed (if loading? 
                        nil 
                        (fn []
                          (let [p1 (.-text pass-ctrl)
                                p2 (.-text confirm-ctrl)]
                            (if (not= p1 p2)
                              (toast/warn ctx "Нууц үг таарахгүй байна.")
                              (auth-ctrl/submit-new-password! ctx phone code p1 !loading?))))))))])
      
      .body
      (m/SafeArea
       .child
       (m/Column
        .children
        [
         ;; 1. Upper Viewport: Form + Floating Candidates
         (m/Expanded
          .child
          (m/Stack
           .children
           [
            (m/SingleChildScrollView
             .scrollDirection m/Axis.horizontal
             .padding (m/EdgeInsets.only .left 24.0 .right 48.0 .top 64.0)
             .physics (m/BouncingScrollPhysics.)
             .child
             (m/Row
              .crossAxisAlignment m/CrossAxisAlignment.start
              .children
              [
               ;; Pillar 1: Visual Anchor & Instructions
               (m/Container
                .width 140.0
                .padding (m/EdgeInsets.only .top 24.0)
                .alignment m/Alignment.topCenter
                .child
                (m/Column
                 .mainAxisSize m/MainAxisSize.min
                 .children
                 [(m/Container
                   .padding (m/EdgeInsets.all 16.0)
                   .decoration (m/BoxDecoration
                                .color theme/bg-color
                                .shape m/BoxShape.circle)
                   .child (m/Icon m/Icons.lock_outline_rounded .color theme/brand-blue .size 28.0))
                  (m/SizedBox .height 24.0)
                  (mgl/MongolText "Шинэ нууц үг" ;; New Password
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                      .fontSize 16.0 
                                                      .fontWeight m/FontWeight.bold 
                                                      .color theme/text-primary))
                  (m/SizedBox .height 16.0)
                  (mgl/MongolText "Та шинэ нууц үгээ оруулна уу." ;; Please enter your new password.
                                  .style (m/TextStyle .fontFamily "OyunQaganTig" 
                                                      .fontSize 13.0 
                                                      .color theme/text-secondary))]))

               (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/border-color)

               ;; Pillar 2: New Password Input
               (auth-input-pillar pass-ctrl "Шинэ нууц үг")
               
               (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/border-color)

               ;; Pillar 3: Confirm Password Input
               (auth-input-pillar confirm-ctrl "Нууц үг давтах")]))
            
            (keyboard/candidates nil)]))

         ;; 2. Lower Viewport: Custom FST Keyboard
         (keyboard/keyboard {})]))))))