(ns mongol-zangila.ui.layout.scaffold
  "Main Application Scaffold wrapping the horizontal BottomNavigationBar.
   ⚡ Upgraded: Features iOS-grade frosted glass (Glassmorphism) and
   fluid expanding active-state animations."
  (:require
   ["package:flutter/material.dart" :as m]
   ["dart:core" :as dc]
   ["dart:ui" :as ui]
   [cljd.flutter :as f]
   [mongol-zangila.state :as state]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]))

(defn- nav-icon
  [ctx icon-data is-active? & {:keys [badge-count]}]
  (let [t (theme/of ctx)
        color (if is-active? (:brand t) (:text-2 t))
        icon (m/Icon icon-data .color color .size 26.0)]
    (m/AnimatedContainer
     .duration (dc/Duration. .milliseconds 300)
     .curve m/Curves.easeOutBack
     .padding (m/EdgeInsets.symmetric
               .horizontal (if is-active? 20.0 14.0)
               .vertical 8.0)
     .decoration (m/BoxDecoration
                  .color (if is-active? (:brand-soft t) m/Colors.transparent)
                  .borderRadius (m/BorderRadius.circular theme/radius-pill))
     .child
     (if (and badge-count (> badge-count 0))
       (m/Badge
        .label (m/Text (if (> badge-count 99) "99+" (str badge-count))
                       .style (m/TextStyle .fontSize 10.0 .fontWeight m/FontWeight.bold))
        .backgroundColor (:error t)
        .child icon)
       icon))))

(def ^:private tabs
  [{:route "/feed/home"          :label "Home"
    :icon m/Icons.home_rounded}
   {:route "/search"             :label "Search"
    :icon m/Icons.search_rounded}
   {:route "/chat/inbox"         :label "Messages"
    :icon m/Icons.chat_bubble_outline_rounded
    :active-icon m/Icons.chat_bubble_rounded
    :badge :msgs}
   {:route "/notifications/view" :label "Notifications"
    :icon m/Icons.notifications_none_rounded
    :active-icon m/Icons.notifications_rounded
    :badge :notifs}
   {:route "/profile/view"       :label "Profile"
    :icon m/Icons.person_outline_rounded
    :active-icon m/Icons.person_rounded}])

(defn- nav-tab
  [ctx current-route badges {:keys [route label icon active-icon badge]}]
  (let [active? (= current-route route)]
    (m/Expanded
     .child
     (m/Semantics
      .label label
      .button true
      .selected active?
      .child
      (m/GestureDetector
       .onTap #(when-not active? (nav/push-replacement! ctx route))
       .behavior m/HitTestBehavior.opaque
       .child
       ;; heightFactor 1.0: bottomNavigationBar gives loose height constraints,
       ;; a plain Center would stretch the bar to full screen height.
       (m/Center
        .heightFactor 1.0
        .child (nav-icon ctx
                         (if active? (or active-icon icon) icon)
                         active?
                         :badge-count (get badges badge))))))))

(defn app-scaffold
  "The root container for top-level navigation screens.
   Optional :floating-action-button is hosted here (same Scaffold as the tab bar)
   so Flutter lifts it above the bottom nav instead of painting it underneath."
  [ctx current-route body-widget & {:keys [floating-action-button]}]
  (f/widget
   :watch [unread-msgs state/unread-messages-count
           unread-notifs state/unread-notifications-count]

   (m/Scaffold
    .backgroundColor (theme/bg ctx)
    ;; extendBody left false (default): body must not sit under the frosted
    ;; bottom nav — horizontal timeline cards fill column height; like/save
    ;; controls at the card foot would land in an untappable glass overlay.
    .body body-widget
    .floatingActionButton floating-action-button

    .bottomNavigationBar
    (m/ClipRect
     .child
     (m/BackdropFilter
      .filter (ui/ImageFilter.blur .sigmaX 20.0 .sigmaY 20.0)
      .child
      (m/Container
       .decoration (m/BoxDecoration
                    .color (.withValues ^m/Color (theme/nav-bar ctx) .alpha 0.8)
                    .border (m/Border .top (theme/hairline ctx)))
       .child
       (m/SafeArea
        .child
        (m/Padding
         .padding (m/EdgeInsets.symmetric .vertical 8.0 .horizontal 8.0)
         .child
         (m/Row
          .children
          (let [badges {:msgs unread-msgs :notifs unread-notifs}]
            (mapv #(nav-tab ctx current-route badges %) tabs)))))))))))
