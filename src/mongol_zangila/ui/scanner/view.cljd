(ns mongol-zangila.ui.scanner.view
  "Hardware-accelerated optical scanner viewport.
   Processes camera feeds to decode QR codes, featuring an LTR-optimized HUD 
   and semantic routing upon successful payload extraction."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/services.dart" :as services]
   ["package:mobile_scanner/mobile_scanner.dart" :as ms]
   ["package:mongol/mongol.dart" :as mgl]
   ["dart:core" :as dc]
   ["dart:async" :as async]
   ["dart:ui" :as ui]
   [cljd.flutter :as f]
   [clojure.string :as str]
   
   ;; UI & Shared Components
   [mongol-zangila.state :as state]
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [components.toast :as toast]))

(def ^:private user-payload-prefix "mz://user/")
(def ^:private scan-window-size 280.0)

;; =============================================================================
;; 1. Payload Parsing & Routing Logic
;; =============================================================================

(defn- parse-user-id
  "Extracts a non-blank user id from `mz://user/{id}` payloads."
  [raw]
  (let [s (str/trim (str raw))]
    (when (str/starts-with? s user-payload-prefix)
      (let [remainder (str/trim (subs s (count user-payload-prefix)))
            id (first (str/split remainder #"[?#/]"))]
        (when-not (str/blank? id)
          id)))))

(defn- cancel-cooldown!
  [!cooldown]
  (when-let [^async/Timer t @!cooldown]
    (.cancel t)
    (reset! !cooldown nil)))

(defn- resume-scanner-later!
  [!scanned? ^ms/MobileScannerController scanner-ctrl !cooldown]
  (cancel-cooldown! !cooldown)
  (reset! !cooldown
          (async/Timer.
           (dc/Duration. .seconds 2)
           (fn []
             (reset! !cooldown nil)
             (reset! !scanned? false)
             (-> (.start scanner-ctrl)
                 (.catchError (fn [_] nil)))
             nil))))

(defn- route-scanned-user!
  [ctx user-id]
  (if (= user-id (get @state/current-user "id"))
    (nav/pop! ctx)
    (nav/push-replacement! ctx "/profile/view" {:user-id user-id})))

(defn- handle-scan-capture!
  [ctx ^ms/BarcodeCapture capture !scanned? ^ms/MobileScannerController scanner-ctrl !cooldown]
  (when-not @!scanned?
    (let [barcodes (.-barcodes capture)]
      (when-let [^ms/Barcode first-code (first barcodes)]
        (let [raw-value (.-rawValue first-code)]
          (when-not (str/blank? raw-value)
            (reset! !scanned? true)
            (.stop scanner-ctrl)
            (services/HapticFeedback.vibrate)
            
            (if-let [user-id (parse-user-id raw-value)]
              (route-scanned-user! ctx user-id)
              (do
                (toast/info ctx "Тодорхойгүй код байна.")
                (resume-scanner-later! !scanned? scanner-ctrl !cooldown))))))))
  nil)

;; =============================================================================
;; 2. Visual Overlay (The Targeting Reticle)
;; =============================================================================

(defn- scanner-overlay []
  (m/IgnorePointer
   .child
   (m/Stack
    .fit m/StackFit.expand
    .children
    [;; srcOut punches a transparent hole so the camera stays visible in the window.
     (m/ColorFiltered
      .colorFilter (ui/ColorFilter.mode (.withOpacity m/Colors.black 0.55) ui/BlendMode.srcOut)
      .child
      (m/Stack
       .fit m/StackFit.expand
       .children
       [(m/Container
         .decoration (m/BoxDecoration
                      .color m/Colors.black
                      .backgroundBlendMode ui/BlendMode.dstOut))
        (m/Center
         .child
         (m/Container
          .width scan-window-size
          .height scan-window-size
          .decoration (m/BoxDecoration
                       .color m/Colors.white
                       .borderRadius (m/BorderRadius.circular 16.0))))]))
     (m/Center
      .child
      (m/Container
       .width scan-window-size
       .height scan-window-size
       .decoration (m/BoxDecoration
                    .borderRadius (m/BorderRadius.circular 16.0)
                    .border (m/Border.all .color theme/brand-blue .width 3.0))))])))

;; =============================================================================
;; 3. The Main Scanner Screen Widget
;; =============================================================================

(defn scanner-screen []
  (let [!scanned? (atom false)
        !torch-on? (atom false)]
    
    (f/widget
     :context ctx
     
     :managed [scanner-ctrl (ms/MobileScannerController. 
                             .facing ms/CameraFacing.back
                             .detectionSpeed ms/DetectionSpeed.noDuplicates)
               :dispose .dispose
               
               !cooldown (atom nil)
               :dispose cancel-cooldown!]
               
     :watch [torch-on? !torch-on?]

     (m/Scaffold
      .backgroundColor m/Colors.black
      
      .body
      (m/Stack
       .children
       [
        ;; --- A. Camera Feed ---
        (ms/MobileScanner
         .controller scanner-ctrl
         .onDetect #(handle-scan-capture! ctx % !scanned? scanner-ctrl !cooldown)
         
         .errorBuilder (fn [c error _]
                         (m/Center 
                          .child (m/Column
                                  .mainAxisSize m/MainAxisSize.min
                                  .children
                                  [(m/Icon m/Icons.videocam_off_rounded .color theme/error-red .size 48.0)
                                   (m/SizedBox .height 24.0)
                                   (mgl/MongolText "Камерын эрх олгогдоогүй байна."
                                                   .style (m/TextStyle .color m/Colors.white 
                                                                       .fontFamily "OyunQaganTig"
                                                                       .fontSize 16.0))]))))
        
        ;; --- B. Overlay ---
        (m/Positioned.fill .child (scanner-overlay))
        
        ;; --- C. Instructional Text ---
        (m/Align
         .alignment (m/Alignment 0.7 0.0)
         .child (m/Container
                 .padding (m/EdgeInsets.symmetric .vertical 24.0 .horizontal 12.0)
                 .decoration (m/BoxDecoration 
                              .color (.withOpacity m/Colors.black 0.7)
                              .borderRadius (m/BorderRadius.circular 24.0))
                 .child (mgl/MongolText "QR кодыг голлуулна уу"
                                        .style (m/TextStyle .color m/Colors.white 
                                                            .fontFamily "OyunQaganTig" 
                                                            .fontSize 16.0))))
        
        ;; --- D. Floating HUD ---
        (m/SafeArea
         .child
         (m/Padding
          .padding (m/EdgeInsets.all 16.0)
          .child
          (m/Column
           .mainAxisAlignment m/MainAxisAlignment.spaceBetween
           .crossAxisAlignment m/CrossAxisAlignment.start
           .children
           [
            (m/Container
             .decoration (m/BoxDecoration .color (.withOpacity m/Colors.black 0.4) .shape m/BoxShape.circle)
             .child (m/IconButton
                     .icon (m/Icon m/Icons.close_rounded .color m/Colors.white)
                     .onPressed (fn [] 
                                  (nav/pop! ctx)
                                  nil)))
            
            (m/Container
             .decoration (m/BoxDecoration .color (.withOpacity m/Colors.black 0.4) .shape m/BoxShape.circle)
             .child (m/IconButton
                     .icon (m/Icon (if torch-on? m/Icons.flash_on_rounded m/Icons.flash_off_rounded) 
                                   .color (if torch-on? theme/warning-yellow m/Colors.white))
                     .onPressed (fn []
                                  (.toggleTorch scanner-ctrl)
                                  (swap! !torch-on? not)
                                  nil)))])))])))))
