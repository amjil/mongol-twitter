(ns mongol-zangila.ui.feed.home
  "Global chronological home timeline (cold-start MVP).
   Shows all platform posts via GET /feed — not a following-only stream.
   Adapted for LTR vertical Mongolian typography with horizontal pull-to-refresh."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:custom_refresh_indicator/custom_refresh_indicator.dart" :as cri]
   ["dart:core" :as dc]
   
   ;; Centralized Dart Interop Interceptor
   ["package:mongol_zangila/post_frame_trigger.dart" :as pft]
   
   [cljd.flutter :as f]
   
   ;; System Controllers & State
   [mongol-zangila.state :as state]
   [mongol-zangila.infrastructure.db :as db] ;; ⚡ Import local offline filter store
   [mongol-zangila.controllers.feed-ctrl :as feed-ctrl]
   
   ;; Shared UI Components
   [mongol-zangila.ui.theme :as theme]
   [mongol-zangila.utils.nav :as nav]
   [mongol-zangila.ui.layout.scaffold :as scaffold] ;; ⚡ Import the new global badge layout
   [mongol-zangila.ui.widgets.empty-state :as empty-state]
   [mongol-zangila.ui.widgets.avatar :as smart-avatar]
   
   ;; Domain Specific Components
   [mongol-zangila.ui.feed.components.post-card :as post-card]
   
   ;; The Custom Horizontal Pull-to-Refresh Library
   [pull-to-refresh.refresh :as ptr]))

;; =============================================================================
;; 1. Sub-component: Sync & Network Indicator
;; =============================================================================

(defn- network-status-indicator []
  (f/widget
   :watch [net-status state/network-status
           syncing? state/sync-in-progress?]
   (cond
     syncing?
     (m/Tooltip 
      .message "Синхрончилж байна..."
      .child (m/SizedBox .width 20.0 .height 20.0 
                         .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/brand-blue)))
     
     (= net-status :offline)
     (m/Tooltip 
      .message "Офлайн горим"
      .child (m/Icon m/Icons.cloud_off_rounded .color theme/error-red .size 24.0))
     
     :else
     (m/SizedBox.shrink))))

(defn- cleanup-refresh-watch [k]
  (remove-watch feed-ctrl/!feed-refresh-trigger k))

;; =============================================================================
;; 2. Main Timeline Screen Widget
;; =============================================================================

(defn home-screen []
  (let [!posts (atom [])
        !blocked-ids (atom #{}) ;; ⚡ Reactive blocklist state
        !page (atom 1)
        !has-more? (atom true)
        !initial-loading? (atom true) 
        !refresh-loading? (atom false)
        !pagination-loading? (atom false)]

    (f/widget
     :context ctx

     :managed [scroll-ctrl (let [ctrl (m/ScrollController.)]
                             (.addListener ctrl
                                           (fn []
                                             (let [pos (.-position ctrl)
                                                   pixels (.-pixels pos)
                                                   max-ext (.-maxScrollExtent pos)]
                                               (when (and (>= pixels (- max-ext 200.0))
                                                          (not @!pagination-loading?)
                                                          (not @!refresh-loading?)
                                                          @!has-more?)
                                                 (feed-ctrl/load-page! ctx "/feed" !posts !page !has-more? !pagination-loading? false)))))
                             ctrl)
               :dispose .dispose
               
               sync-watcher (let [key (keyword (str "home-" (.-millisecondsSinceEpoch (dc/DateTime.now))))]
                              (add-watch feed-ctrl/!feed-refresh-trigger key
                                         (fn [_ _ old-val new-val]
                                           (when (> new-val old-val)
                                             (feed-ctrl/load-page! ctx "/feed" !posts !page !has-more? !refresh-loading? true))))
                              key)
               :dispose cleanup-refresh-watch]

     :watch [posts !posts
             blocked-ids !blocked-ids
             init-loading? !initial-loading?
             page-loading? !pagination-loading?
             has-more? !has-more?
             current-user state/current-user]

     (let [user-id (get current-user "id")
           avatar-url (get current-user "avatar_url")
           on-compose #(nav/push-fullscreen! ctx "/feed/compose")
           
           ;; ⚡ Before render: strictly drop posts whose authors are locally blocked
           visible-posts (vec (remove #(contains? blocked-ids (get-in % ["author" "id"])) posts))]

       (pft/PostFrameTrigger
        .onLayout (fn []
                    (feed-ctrl/load-page! ctx "/feed" !posts !page !has-more? !initial-loading? true)
                    (-> (db/get-blocked-user-ids) (.then #(reset! !blocked-ids %)))
                    nil)
        .child
        
        ;; ⚡ Core swap: app-scaffold fully owns the global Bottom Navigation Bar
        (scaffold/app-scaffold 
         ctx "/feed/home"
         (m/Scaffold
          .backgroundColor (theme/bg ctx)

          .appBar
          (m/AppBar
           .backgroundColor (theme/surface ctx)
           .elevation 0.5
           .automaticallyImplyLeading false
           .leading (m/Padding
                     .padding (m/EdgeInsets.all 8.0)
                     .child
                     (m/GestureDetector
                      .onTap #(nav/push! ctx "/profile/view" {:user-id "self"})
                      .child (smart-avatar/smart-avatar ctx user-id avatar-url :size 40.0)))

           .title (m/Icon m/Icons.water_drop_rounded .color theme/brand-blue .size 32.0)
           .centerTitle true

           .actions [(m/Padding
                      .padding (m/EdgeInsets.only .right 8.0)
                      .child (network-status-indicator))])

          .body
          (if init-loading?
            (m/Center .child (m/CircularProgressIndicator .color theme/brand-blue))

            (if (empty? visible-posts)
              (m/Center .child (empty-state/empty-feed-view ctx on-compose))

              (ptr/horizontal-refresh
               {:on-refresh (fn []
                              ;; ⚡ Also refresh the blocklist on pull-to-refresh
                              (-> (db/get-blocked-user-ids) (.then #(reset! !blocked-ids %)))
                              (feed-ctrl/load-page! ctx "/feed" !posts !page !has-more? !refresh-loading? true))
                
                :scroll-controller scroll-ctrl
                :background-color (theme/bg ctx)
                
                :not-armed-text "Татаж шинэчлэх"
                :armed-text "Суллаж шинэчлэх"
                :loading-text "Шинэчилж байна"
                :not-armed-color (theme/border ctx)
                :armed-color theme/brand-blue
                :text-style (m/TextStyle .fontFamily "OyunQaganTig" .color m/Colors.white .fontSize 14.0 .fontWeight m/FontWeight.bold)
                :trigger-mode cri/IndicatorTriggerMode.anywhere
                
                :item-count (if (and has-more? page-loading?) (inc (count visible-posts)) (count visible-posts))
                :separator-builder (fn [_ _] (m/SizedBox .width 0.0))
                :box-shadow []
                
                :item-builder
                (fn [_ i]
                  (if (and page-loading? (= i (count visible-posts)))
                    (m/Padding
                     .padding (m/EdgeInsets.symmetric .horizontal 32.0)
                     .child (m/Center .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/brand-blue)))

                    ;; ⚡ Render from visible-posts
                    (let [post-data (nth visible-posts i)]
                      (m/Container
                       .margin post-card/timeline-card-margin
                       .child (post-card/post-card 
                               ctx post-data
                               :on-mutate (fn [mutator]
                                            (swap! !posts (fn [ps]
                                                            (mapv #(if (= (get % "id") (get post-data "id"))
                                                                     (mutator %)
                                                                     %)
                                                                  ps))))
                               :on-delete #(feed-ctrl/delete-post! ctx (get post-data "id") !posts))))))})))

          .floatingActionButton
          (m/FloatingActionButton
           .backgroundColor theme/brand-blue
           .elevation 4.0
           .onPressed on-compose
           .child (m/Icon m/Icons.edit_rounded .color m/Colors.white)))))))))