(ns mongol-zangila.infrastructure.socket
  (:require
   ["dart:core" :as dc]
   ["dart:async" :as async]
   ["dart:math" :as math]
   ["package:phoenix_wings/phoenix_wings.dart" :as phx]
   [clojure.string :as str]
   
   ;; System Dependencies
   [mongol-zangila.state :as state]
   [mongol-zangila.infrastructure.config :as config]))

;; =============================================================================
;; 1. Global Socket Instance & Memory Registries
;; =============================================================================

(defonce ^:private !socket (atom nil))

;; Active physical channel connections (cleared on disconnect)
(defonce ^:private !active-channels (atom {}))

;; ⚡ Subscription-intent registry (owned by UI; must survive disconnect for reconnect restore)
(defonce ^:private !channel-subscriptions (atom {}))
(defonce ^:private !on-connect-callbacks (atom []))
(defonce ^:private !inbox-event-callbacks (atom []))

;; Reconnect-storm defenses
(defonce ^:private !reconnect-attempts (atom 0))
(defonce ^:private !rejoin-debounce-timer (atom nil))
(defonce ^:private !reconnect-timer (atom nil))
(defonce ^:private !last-post-connect-ms (atom 0))
(defonce ^:private !connect-in-flight? (atom false))

(def ^:private post-connect-min-interval-ms 2000)
(def ^:private base-reconnect-backoff-ms 1000)
(def ^:private max-reconnect-backoff-ms 30000)

(declare rejoin-all-channels!)

(defn on-connect!
  "Registers a callback invoked whenever the socket connects or reconnects."
  [callback-fn]
  (swap! !on-connect-callbacks conj callback-fn))

(defn on-inbox-event!
  "Registers a callback for user-channel inbox events: :new_message / :thread_updated."
  [callback-fn]
  (swap! !inbox-event-callbacks conj callback-fn))

(defn remove-inbox-event!
  [callback-fn]
  (swap! !inbox-event-callbacks
         (fn [cbs] (vec (remove #(identical? % callback-fn) cbs)))))

;; =============================================================================
;; 2. Connection Lifecycle Management
;; =============================================================================

(defn- build-ws-url []
  (let [base config/base-url
        ws-base (str/replace base #"^http" "ws")]
    (str/replace ws-base #"/api/v1$" "/socket/websocket")))

(defn- cancel-timer! [!t]
  (when-let [t @!t]
    (.cancel ^async/Timer t)
    (reset! !t nil)))

(defn- run-post-connect!
  "Fires on-connect callbacks and rejoins preserved channel intents."
  []
  (reset! !reconnect-attempts 0)
  (reset! !last-post-connect-ms (.-millisecondsSinceEpoch (dc/DateTime.now)))
  (doseq [cb @!on-connect-callbacks] (cb))
  (rejoin-all-channels!))

(defn- schedule-post-connect!
  "Absorbs rapid Phoenix onOpen storms (tunnel / elevator flaky nets).
   Immediate on first connect or when enough time elapsed; otherwise debounce."
  []
  (let [now (.-millisecondsSinceEpoch (dc/DateTime.now))
        elapsed (- now @!last-post-connect-ms)
        first-or-cooled? (or (zero? @!last-post-connect-ms)
                             (>= elapsed post-connect-min-interval-ms))]
    (cancel-timer! !rejoin-debounce-timer)
    (if first-or-cooled?
      (run-post-connect!)
      (let [wait-ms (- post-connect-min-interval-ms elapsed)]
        (dc/print (str "⏳ [Socket] Debouncing post-connect restore by " wait-ms "ms"))
        (reset! !rejoin-debounce-timer
                (async/Timer. (dc/Duration. .milliseconds wait-ms)
                              (fn []
                                (reset! !rejoin-debounce-timer nil)
                                (run-post-connect!))))))))

(defn- calculate-reconnect-backoff-ms [attempt-count]
  (let [capped (min (max attempt-count 0) 5)
        multiplier (math/pow 2 capped)]
    (min max-reconnect-backoff-ms
         (int (* base-reconnect-backoff-ms multiplier)))))

(defn disconnect! 
  "Severs the WebSocket connection and clears ACTIVE channel registries. 
   ⚡ Crucially PRESERVES subscriptions and callbacks so they survive auto-reconnects."
  []
  (cancel-timer! !rejoin-debounce-timer)
  (cancel-timer! !reconnect-timer)
  (reset! !connect-in-flight? false)
  (when-let [socket @!socket]
    (.disconnect socket)
    (reset! !socket nil)
    (reset! !active-channels {})
    ;; Never clear !channel-subscriptions or !inbox-event-callbacks here
    (dc/print "🔌 [Socket] Physical connection severed, registries preserved.")))

;; ⚡ Core fix: add the missing full-teardown!
(defn full-teardown!
  "Completely dismantles the socket and ALL memory registries. Used strictly on Logout."
  []
  (disconnect!)
  (reset! !channel-subscriptions {})
  (reset! !inbox-event-callbacks [])
  (reset! !reconnect-attempts 0)
  (reset! !last-post-connect-ms 0)
  (dc/print "🧹 [Socket] Full teardown complete. Registries wiped."))

(defn connected? []
  (boolean @!socket))

(defn connect! 
  "Opens a WebSocket when none is active. No-op if already connected or in-flight."
  []
  (when (and (not @!socket) (not @!connect-in-flight?))
    (when-let [token @state/auth-token]
      (reset! !connect-in-flight? true)
      (let [ws-url (build-ws-url)
            ;; Phoenix mutates params (adds "vsn"); must be a Dart Map, not PersistentHashMap.
            params (dc/Map.fromEntries
                     (dc/List.from [(dc/MapEntry. "token" token)]))
            socket-opts (phx/PhoenixSocketOptions. .params params)
            socket (phx/PhoenixSocket. ws-url .socketOptions socket-opts)]
        
        (.onOpen socket (fn [] 
                          (reset! !connect-in-flight? false)
                          (dc/print "🟢 [Socket] Connected to Phoenix Cluster.")
                          (schedule-post-connect!)))
        
        (.onClose socket (fn [_] 
                           (reset! !connect-in-flight? false)
                           (swap! !reconnect-attempts inc)
                           (dc/print (str "🔴 [Socket] Connection Closed (attempt "
                                          @!reconnect-attempts ")"))))
        
        (.onError socket (fn [err] 
                           (dc/print (str "⚠️ [Socket] Error: " err))))
        
        (.connect socket)
        (reset! !socket socket)))))

(defn reconnect!
  "Tears down any existing socket and connects with the current JWT.
   Uses exponential backoff after repeated close storms (same idea as write-buffer)."
  []
  (cancel-timer! !reconnect-timer)
  (let [attempt @!reconnect-attempts
        delay-ms (if (zero? attempt) 0 (calculate-reconnect-backoff-ms attempt))]
    (disconnect!)
    (if (zero? delay-ms)
      (connect!)
      (do
        (dc/print (str "⏳ [Socket] Reconnect backoff " delay-ms "ms (attempt " attempt ")"))
        (reset! !reconnect-timer
                (async/Timer. (dc/Duration. .milliseconds delay-ms)
                              (fn []
                                (reset! !reconnect-timer nil)
                                (connect!))))))))

(defn ensure-connected! []
  (connect!))

;; =============================================================================
;; 3. Channel Multiplexing & Subscription
;; =============================================================================

(defn- do-join-channel!
  [topic event-handlers]
  (when (and @!socket (not (contains? @!active-channels topic)))
    (let [channel (.channel @!socket topic)
          join-push (.join channel)]
      (.receive join-push "ok"
                (fn [_] (dc/print (str "✅ [Channel] Joined: " topic))))
      (.receive join-push "error"
                (fn [res] (dc/print (str "❌ [Channel] Failed to join " topic ": " res))))
      (doseq [[event-name cb-fn] event-handlers]
        (.on channel event-name (fn [payload _ref _join-ref]
                                  (cb-fn payload))))
      (swap! !active-channels assoc topic channel)
      channel)))

(defn- rejoin-all-channels!
  "Iterates over preserved UI intents and automatically re-binds them."
  []
  (reset! !active-channels {})
  (doseq [[topic handlers] @!channel-subscriptions]
    (do-join-channel! topic handlers)))

(defn join-channel! 
  "Subscribes to a specific Phoenix Channel. Preserves intent for reconnects."
  [topic event-handlers]
  (swap! !channel-subscriptions assoc topic event-handlers)
  (if-not @!socket
    (dc/print (str "⏳ [Socket] Not connected. Will join " topic " upon next connect."))
    (do-join-channel! topic event-handlers)))

(defn leave-channel! 
  "Gracefully leaves a channel and removes it from the local registry."
  [topic]
  (swap! !channel-subscriptions dissoc topic)
  (when-let [channel (get @!active-channels topic)]
    (.leave channel)
    (swap! !active-channels dissoc topic)
    (dc/print (str "👋 [Channel] Left: " topic))))

;; =============================================================================
;; 4. Global System Listeners (The Background Daemon)
;; =============================================================================

(defn- notify-inbox-callbacks!
  [event-type payload]
  (doseq [cb @!inbox-event-callbacks]
    (cb event-type payload)))

(defn boot-system-daemons! 
  "Subscribes to global user-centric channels that must always be active."
  []
  (let [user-id (get @state/current-user "id")]
    (when user-id
      (join-channel!
       (str "user:notifications:" user-id)
       {"new_notification"
        (fn [_payload]
          (dc/print "🔔 [Daemon] New notification received!")
          (swap! state/unread-notifications-count inc))
        "clear_badge"
        (fn [_payload]
          (dc/print "🧹 [Daemon] Clearing notification badge.")
          (reset! state/unread-notifications-count 0))})

      (join-channel!
       (str "user:" user-id)
       {"new_message"
        (fn [payload]
          (when-not (= (get payload "sender_id") user-id)
            (swap! state/unread-messages-count inc))
          (notify-inbox-callbacks! :new_message payload))
        "thread_updated"
        (fn [payload]
          (notify-inbox-callbacks! :thread_updated payload))}))

    (dc/print "🛡️ [Daemon] System listeners successfully booted/restored.")))

(on-connect! boot-system-daemons!)
