(ns mongol-zangila.main
  "App global entry: engine init, local storage, IME warmup, and root MaterialApp."
  (:require
   ["package:flutter/material.dart" :as m]
   ["package:flutter/foundation.dart" :as foundation :refer [kIsWeb]]
   [cljd.flutter :as f]

   [mongol-zangila.router :as router]
   [mongol-zangila.state :as state]
   [mongol-zangila.infrastructure.api :as api]
   [mongol-zangila.infrastructure.db :as db]
   [mongol-zangila.infrastructure.storage :as storage]
   [mongol-zangila.infrastructure.socket :as socket]
   [mongol-zangila.infrastructure.write-buffer :as write-buffer]
   [mongol-zangila.infrastructure.local-notifications :as local-notif]
   [mongol-zangila.ui.theme :as theme]

   [virtual-keyboard.input-control :as input-control]
   [ime-core.remote-api :as remote]
   [ime-core.fst-engine :as fst]
   [ime-core.next-word :as next-word]))

(defn is-mobile? []
  (let [platform foundation/defaultTargetPlatform]
    (or (= platform foundation/TargetPlatform.android)
        (= platform foundation/TargetPlatform.iOS))))

(defn ^:async init-app! []
  ;; Standardized dot notation for Flutter binding initialization
  (m/WidgetsFlutterBinding.ensureInitialized)
  
  ;; Await the actual Drift database initialization
  (await (db/initialize-database!))
  (await (theme/load-mode!))
  (await (storage/load-prefs!))

  ;; Initialize local notifications plugin (channels + OS permissions)
  (local-notif/init!))

(defn ^:async main []
  (await (init-app!))

  (remote/set-config! {:base-url "http://localhost:3003"
                       :candidate-api-path "/api/next_word/candidates"
                       :next-word-api-path "/api/next_word/list"})

  (when-not kIsWeb
    (await (fst/ensure-loaded))
    (await (next-word/ensure-loaded)))

  (when (is-mobile?)
    (input-control/set-control))

  (f/run
   (f/widget
    :managed [_lifecycle (m/AppLifecycleListener.
                          .onResume (fn []
                                      (when @state/auth-token
                                        (socket/ensure-connected!)
                                        (write-buffer/flush-outbox!))))
              :dispose .dispose]
    :watch [mode theme/!mode]
    (m/MaterialApp
     .title "Монгол Зангилаа"
     .debugShowCheckedModeBanner false
     .navigatorKey api/global-navigator-key
     .theme theme/light-theme
     .darkTheme theme/dark-theme
     .themeMode (theme/theme-mode-enum mode)
     .initialRoute "/splash"
     ;; ⚡ FIXED: Explicitly typed wrapper forces Dart to recognize the exact callback signature
     .onGenerateRoute (fn [^m/RouteSettings settings]
                        (router/on-generate-route settings))))))